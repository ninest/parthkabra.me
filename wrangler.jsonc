{
  "compatibility_date": "2026-04-10",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "me",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "workers_dev": false,
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "me-production",
      "database_id": "a982122a-a012-4f5e-9270-d576ece2bcad",
      "migrations_dir": "migrations",
    },
  ],
}
