{
  // The production site: the static build in dist/, plus worker/index.ts for what needs a server.
  "name": "me",
  "compatibility_date": "2026-04-10",
  "main": "worker/index.ts",
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": { "NTFY_TOPIC": "parthkabra-new-subscriber" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "me-production",
      "database_id": "a982122a-a012-4f5e-9270-d576ece2bcad",
      "migrations_dir": "migrations"
    }
  ]
}
