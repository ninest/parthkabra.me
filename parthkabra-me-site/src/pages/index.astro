---
import SidebarLayout from "../components/sidebar-layout.astro";
import MicroblogSidebar from "../components/microblog/microblog-sidebar.astro";
import CategoryList from "../components/category-list.astro";
import { assetUrl, ofKind, site, workByOrder } from "../lib/content";
import { getPageUrl, routes } from "../utils/links";

const { now, links } = site();
const work = workByOrder().filter((w) => w.frontmatter.featured);
const projects = ofKind("project").filter((p) => p.frontmatter.featured);
const posts = ofKind("post").slice(0, 10);
const isExternal = (url: string) => /^https?:/.test(url);
---

<SidebarLayout
  head={{
    fullTitle: "Parth Kabra — Software Engineer",
    description: "Parth Kabra is a full-stack software engineer building at the intersection of AI, product, and UX.",
  }}
>
  <section>
    <h2 class="font-bold">Currently</h2>
    <p class="ml-5 mt-1">Software engineer @ Wayfair</p>
  </section>

  <section class="mt-8">
    <h2 class="font-bold">Links</h2>
    <p class="ml-5 mt-1">
      {
        links.map((link, i) => (
          <span><a href={link.url} target={isExternal(link.url) ? "_blank" : undefined} class="underline text-primary">{link.title}</a>{i < links.length - 1 && ", "}</span>
        ))
      }
    </p>
  </section>

  <section class="mt-8">
    <h2 class="font-bold">About</h2>
    <p class="ml-5 mt-1">
      Full-stack engineer building at the intersection of AI, product, and UX. From tools used at scale to AI-powered consumer products, I like turning ideas into software people actually use.{" "}
      <a class="text-primary underline" href={getPageUrl("about")}>Read more</a>
    </p>
  </section>

  <section class="mt-8">
    <div class="flex items-center justify-between">
      <h2 class="font-bold">Work</h2>
      <a href={routes.work} class="underline text-sm text-primary">View all</a>
    </div>
    <table class="ml-5 mt-1 w-[calc(100%-1.25rem)] border-collapse border border-border">
      <tbody>
        {
          work.map((ex, i) => (
            <tr class={i % 2 === 1 ? "bg-muted" : ""}>
              <td class="border border-border">
                <a href={ex.href} class="block py-1 px-2">
                  <span class="inline-flex items-center gap-1.5">
                    <span class="inline-block w-4 h-4 shrink-0">
                      {ex.frontmatter.icon && <img src={assetUrl(ex, ex.frontmatter.icon)} alt={`${ex.title} logo`} class="w-4 h-4" />}
                    </span>
                    {ex.title}
                  </span>
                </a>
              </td>
              <td class="border border-border text-right tabular-nums">
                <a href={ex.href} class="block py-1 px-2">{ex.frontmatter.dateline}</a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="mt-8">
    <div class="flex items-center justify-between">
      <h2 class="font-bold">Recent Projects</h2>
      <a href={routes.projects} class="underline text-sm text-primary">View all</a>
    </div>
    <ul class="mt-1 ml-3 space-y-2 list-none">
      {
        projects.map((p) => (
          <li class="pl-5 before:content-['-'] before:absolute before:left-0 relative">
            <a href={p.href} class="underline text-primary">{p.title}</a>: <span>{p.description}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-8">
    <div class="flex items-center justify-between">
      <h2 class="font-bold">Posts</h2>
      <a href={routes.all} class="underline text-sm text-primary">View all</a>
    </div>
    <ul class="ml-5 mt-1 space-y-1.5">
      {
        posts.map((post) => (
          <li>
            <a href={post.href} target={post.external ? "_blank" : undefined} rel={post.external ? "noopener" : undefined} class="underline text-primary">{post.title}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <CategoryList />

  <section slot="sidebar" class="mt-8">
    <h2 class="font-bold">Now</h2>
    <p class="ml-5 mt-1">{now}</p>
  </section>

  <div slot="sidebar" class="mt-8">
    <MicroblogSidebar />
  </div>
</SidebarLayout>
