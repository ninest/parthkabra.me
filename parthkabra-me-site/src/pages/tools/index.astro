---
import SidebarLayout from "../../components/sidebar-layout.astro";
import { ofKind } from "../../lib/content";

const tools = ofKind("tool");
---

<SidebarLayout head={{ title: "Tools", description: "Small tools that run in the browser" }} breadcrumbs={[{ label: "Parth Kabra", href: "/" }, { label: "Tools" }]}>
  <h1 class="text-3xl font-black">Tools</h1>

  <section class="mt-8">
    <ul class="space-y-4">
      {
        tools.map((t) => (
          <li>
            <a href={t.href} class="block">
              <div class="font-bold">{t.title}</div>
              <div>{t.description}</div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</SidebarLayout>
