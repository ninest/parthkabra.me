---
// A tool gets the whole viewport under a slim navbar; the one form-like tool sits in the normal page.
import Base from "../../layouts/Base.astro";
import AbsolutelyWrite from "../../components/tools/AbsolutelyWrite.astro";
import AIMapMaker from "../../components/tools/AIMapMaker.astro";
import AverageLocationCalculator from "../../components/tools/AverageLocationCalculator.astro";
import DuplicateWordFinder from "../../components/tools/DuplicateWordFinder.astro";
import MapDrawer from "../../components/tools/MapDrawer.astro";
import FilledNavbar from "../../components/filled-navbar.astro";
import Navbar from "../../components/navbar.astro";
import PageTitle from "../../components/page-title.astro";
import Search from "../../components/search.astro";
import { bodyOf, formatDate, ofKind, type Item } from "../../lib/content";
import { pageTheme } from "../../lib/theme";
import { routes } from "../../utils/links";

const COMPONENTS = {
  "absolutely-write": { Tool: AbsolutelyWrite, fill: true },
  "ai-map-maker": { Tool: AIMapMaker, fill: true },
  "average-location-calculator": { Tool: AverageLocationCalculator, fill: false },
  "duplicate-word-finder": { Tool: DuplicateWordFinder, fill: true },
  "map-drawer": { Tool: MapDrawer, fill: true },
} as const;
type Name = keyof typeof COMPONENTS;

export function getStaticPaths() {
  return ofKind("tool").flatMap((item) => {
    const name = /```component:([\w-]+)/.exec(bodyOf(item))?.[1];
    return name ? [{ params: { slug: item.slug }, props: { item, name } }] : [];
  });
}

const { item, name } = Astro.props as { item: Item; name: Name };
const { Tool, fill } = COMPONENTS[name];
const theme = pageTheme(item);
const color = theme.navbarColor;
const crumbs = [
  { label: "Parth Kabra", href: routes.home },
  { label: "Tools", href: routes.tools },
];
const head = { title: item.title, description: item.description, themeColor: color };
---

<Base head={head}>
  {
    fill ? (
      <div class="fixed inset-0 flex flex-col">
        {color ? (
          <FilledNavbar color={color} class="py-3" breadcrumbs={[...crumbs, { label: item.title }]} />
        ) : (
          <div class="px-4 py-3 border-b border-border bg-background">
            <Navbar breadcrumbs={[...crumbs, { label: item.title }]} />
          </div>
        )}
        <main class="flex-1 min-h-0 relative">
          <Tool />
        </main>
      </div>
    ) : (
      <>
        {color && <FilledNavbar color={color} breadcrumbs={crumbs} />}
        <div class="px-4">
          <div class:list={["max-w-300 mx-auto", color ? "mb-16" : "my-16"]}>
            {!color && <Navbar breadcrumbs={crumbs} />}
            <div class="mt-8 flex flex-col md:flex-row gap-12 lg:gap-24">
              <div class="flex-1 min-w-0">
                <PageTitle title={item.title} theme={theme} />
                <p class="mt-2 text-muted-foreground">{formatDate(item.date, "month")} · {item.description}</p>
              </div>
              <div class="hidden md:block md:w-72 lg:w-84 shrink-0">
                <Search />
              </div>
            </div>
            <main class="mt-8">
              <Tool />
            </main>
          </div>
        </div>
      </>
    )
  }
</Base>
