---
import Note from "../components/microblog/note.astro";
import ThreadList from "../components/microblog/thread-list.astro";
import SidebarLayout from "../components/sidebar-layout.astro";
import { microThreads, ofKind } from "../lib/content";

const threads = microThreads();
const count = ofKind("micro").length;
---

<SidebarLayout head={{ title: "Microblog", description: "All microblog posts" }} breadcrumbs={[{ label: "Parth Kabra", href: "/" }, { label: "Microblog" }]}>
  <h1 class="text-3xl font-black">Microblog ({count})</h1>

  <div class="mt-8 divide-y divide-border border-y border-border">
    {
      threads.map((notes) => (
        <div>
          {notes.map((note, n) => (
            <Note note={note} threadedUp={n > 0} threadedDown={n < notes.length - 1} />
          ))}
        </div>
      ))
    }
  </div>

  <ThreadList slot="sidebar" />
</SidebarLayout>
