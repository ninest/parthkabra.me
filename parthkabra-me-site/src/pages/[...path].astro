---
// Every item with a page of its own, at the URL the content guide gives it.
import CategoryList from "../components/category-list.astro";
import MicroblogSidebar from "../components/microblog/microblog-sidebar.astro";
import Note from "../components/microblog/note.astro";
import ThreadList from "../components/microblog/thread-list.astro";
import PageTitle from "../components/page-title.astro";
import PostList from "../components/post-list.astro";
import SidebarLayout from "../components/sidebar-layout.astro";
import {
  assetUrl,
  bodyOf,
  byPath,
  formatDate,
  hasPage,
  items,
  ofKind,
  thread,
  workByOrder,
  type Item,
} from "../lib/content";
import { render } from "../lib/markdown";
import { pageTheme } from "../lib/theme";
import { getCategoryUrl, routes } from "../utils/links";

export function getStaticPaths() {
  return items()
    .filter(hasPage)
    .map((item) => ({ params: { path: item.href.slice(1) }, props: { item } }));
}

const { item } = Astro.props as { item: Item };
const fm = item.frontmatter;
const home = { label: "Parth Kabra", href: "/" };
const theme = pageTheme(item);
const r = await render(item);
const head = { title: item.title, description: item.description };
const month = item.date && formatDate(item.date, "month");

// What goes under the title and in the sidebar depends on the kind of page.
const firstCategory = item.categories[0];
const categoryTitle = firstCategory ? (byPath(`categories/${firstCategory}`)?.title ?? firstCategory) : "";

const breadcrumbs = {
  post: [home, { label: categoryTitle, href: firstCategory && getCategoryUrl(firstCategory) }],
  micro: [home, { label: "Microblog", href: routes.microblog }],
  project: [home, { label: "Projects", href: routes.projects }],
  work: [home, { label: "Work", href: routes.work }],
  collection: [home],
  page: [home],
  category: [home, { label: item.title }],
}[item.kind];

const subtitle = {
  post: [month, item.description],
  project: [month, item.description],
  work: [item.description, fm.location, fm.dateline],
  page: [item.description],
  collection: [item.description],
}[item.kind as string]
  ?.filter(Boolean)
  .join(" · ");

const notes = item.kind === "micro" ? thread(item) : [];

const sameCategory = ofKind("post")
  .filter((p) => p !== item && p.categories[0] === firstCategory)
  .slice(0, 8);
const otherProjects = ofKind("project").filter((p) => p !== item);
const otherPages = ofKind("page")
  .filter((p) => p !== item)
  .sort((a, b) => a.title.localeCompare(b.title));
const work = workByOrder();
const at = work.indexOf(item);
const neighbours = item.kind === "work" ? [{ label: "Next", item: work[at - 1] }, { label: "Previous", item: work[at + 1] }].filter((n) => n.item) : [];

const categoryPosts = ofKind("post").filter((p) => p.categories.includes(item.slug));
const categoryNotes = ofKind("micro").filter((m) => m.categories.includes(item.slug));
const hasBody = bodyOf(item).trim().length > 0;
---

<SidebarLayout head={head} breadcrumbs={breadcrumbs} navbarColor={theme.navbarColor}>
  {
    item.kind === "micro" ? (
      <div class="border-y border-border">
        {notes.map((note, n) => (
          <Note note={note} current={note === item && notes.length > 1} threadedUp={n > 0} threadedDown={n < notes.length - 1} />
        ))}
      </div>
    ) : (
      <>
        <PageTitle title={item.title} theme={theme} icon={fm.icon && assetUrl(item, fm.icon)} />
        {subtitle && <p class="mt-2 text-muted-foreground">{subtitle}</p>}

        {item.kind === "category" ? (
          <>
            {hasBody && <article class="mt-4 typography" set:html={r.html} />}
            <section class="mt-8">
              <PostList posts={categoryPosts} />
            </section>
            {categoryNotes.length > 0 && (
              <div class="mt-8">
                <MicroblogSidebar notes={categoryNotes} title="Microposts" showViewAll={false} />
              </div>
            )}
          </>
        ) : (
          <article class="mt-8 typography" set:html={r.html} />
        )}
      </>
    )
  }

  <Fragment slot="sidebar">
    {item.kind === "category" && <CategoryList />}
    {item.kind === "micro" && <ThreadList />}

    {
      item.kind === "post" && sameCategory.length > 0 && (
        <nav class="mt-8 rounded-md overflow-hidden flex flex-col gap-1">
          {sameCategory.map((post) => (
            <a href={post.href} target={post.external ? "_blank" : undefined} rel={post.external ? "noopener" : undefined} class="block bg-muted py-1 px-2">
              <div class="text-sm text-muted-foreground">{post.date.slice(0, 7).replace("-", "/")}</div>
              <div class="mt-1 font-semibold">{post.title}</div>
            </a>
          ))}
        </nav>
      )
    }

    {
      neighbours.length > 0 && (
        <nav class="mt-8 rounded-md overflow-hidden flex flex-col gap-1">
          {neighbours.map((n) => (
            <a href={n.item!.href} class="block bg-muted py-1 px-2">
              <div class="text-sm">{n.label}</div>
              <div class="mt-1 font-semibold">{n.item!.title}</div>
            </a>
          ))}
        </nav>
      )
    }

    {
      item.kind === "project" && (
        <nav class="mt-8">
          <h2 class="font-bold">Projects</h2>
          <div class="mt-1 rounded-md overflow-hidden flex flex-col gap-1">
            {otherProjects.map((project) => (
              <a href={project.href} class="block bg-muted py-1 px-2">
                <div class="mt-1">{project.title}</div>
              </a>
            ))}
          </div>
        </nav>
      )
    }

    {
      item.kind === "page" && otherPages.length > 0 && (
        <nav class="mt-8">
          <h2 class="font-bold">Pages</h2>
          <div class="mt-1 rounded-md overflow-hidden flex flex-col gap-1">
            {otherPages.map((page) => (
              <a href={page.href} class="block bg-muted py-1 px-2">
                <div class="mt-1">{page.title}</div>
              </a>
            ))}
          </div>
        </nav>
      )
    }
  </Fragment>
</SidebarLayout>
