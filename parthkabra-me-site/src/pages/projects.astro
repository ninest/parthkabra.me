---
import SidebarLayout from "../components/sidebar-layout.astro";
import { ofKind } from "../lib/content";

const projects = ofKind("project");
---

<SidebarLayout head={{ title: "Projects", description: "Parth Kabra's projects" }} breadcrumbs={[{ label: "Parth Kabra", href: "/" }, { label: "Projects" }]}>
  <h1 class="text-3xl font-black">Projects</h1>

  <section class="mt-8">
    <ul class="space-y-4">
      {
        projects.map((p) => (
          <li>
            <a href={p.href} class="block">
              <div class="font-bold">{p.title}</div>
              <div>{p.description}</div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</SidebarLayout>
