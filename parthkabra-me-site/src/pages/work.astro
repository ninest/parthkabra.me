---
import SidebarLayout from "../components/sidebar-layout.astro";
import { assetUrl, workByOrder } from "../lib/content";

const work = workByOrder();
---

<SidebarLayout head={{ title: "Work", description: "Parth Kabra's work experience" }} breadcrumbs={[{ label: "Parth Kabra", href: "/" }, { label: "Work" }]}>
  <h1 class="text-3xl font-black">Work experience</h1>

  <section class="mt-8">
    <ul class="space-y-4">
      {
        work.map((ex) => (
          <li>
            <a href={ex.href} class="block">
              <div class="flex items-center gap-3">
                <span class="inline-block w-4 h-4 shrink-0">
                  {ex.frontmatter.icon && <img src={assetUrl(ex, ex.frontmatter.icon)} alt={`${ex.title} logo`} class="w-4 h-4" />}
                </span>
                <div class="font-bold">{ex.title}</div>
              </div>
              <div class="ml-7">{ex.description}</div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</SidebarLayout>
