---
// A compact list of notes, for sidebars.
import { excerpt, firstImage, formatDate, ofKind, type Item } from "../../lib/content";
import { routes } from "../../utils/links";

type Props = { notes?: Item[]; title?: string; showViewAll?: boolean };
const { notes = ofKind("micro").slice(0, 10), title = "Microblog", showViewAll = true } = Astro.props;
---

<section>
  <div class="flex items-center justify-between">
    <h2 class="font-bold">{title}</h2>
    {showViewAll && <a href={routes.microblog} class="underline text-sm text-primary">View all</a>}
  </div>

  <ul class="mt-2 divide-y divide-border border-y border-border">
    {
      notes.map((note) => {
        const image = firstImage(note);
        return (
          <li>
            <a href={note.href} class="block py-3 hover:bg-muted/50">
              <p class="text-sm text-muted-foreground">{formatDate(note.date)}</p>
              <p class="mt-0.5 text-sm font-semibold">{note.title}</p>
              <p class="mt-0.5 line-clamp-3 text-sm leading-snug">{excerpt(note, 160)}</p>
              {image && <img src={image} alt="" loading="lazy" class="mt-2 max-h-32 rounded-lg ring-1 ring-border" />}
            </a>
          </li>
        );
      })
    }
  </ul>
</section>
