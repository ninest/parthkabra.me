---
// PROTOTYPE (throwaway): floating bar that flips between variants on the page via ?variant=.
// Dev only. Reads the variant list from the first [data-variants="A:name,B:name"] on the page.
---

{
  import.meta.env.DEV && (
    <>
      <script is:inline>
        document.documentElement.dataset.variant = new URLSearchParams(location.search).get("variant") || "A";
      </script>
      <div id="pswitch" hidden>
        <button data-d="-1" aria-label="Previous variant">←</button>
        <span></span>
        <button data-d="1" aria-label="Next variant">→</button>
      </div>
      <style>
        #pswitch { position: fixed; bottom: 1.25rem; left: 50%; transform: translateX(-50%); z-index: 99; display: flex; align-items: center; gap: 0.25rem; background: #111; color: #fff; border-radius: 999px; padding: 0.3rem; box-shadow: 0 6px 24px #0004; font: 13px/1 system-ui, sans-serif; }
        #pswitch[hidden] { display: none; }
        #pswitch span { min-width: 9rem; text-align: center; }
        #pswitch button { all: unset; cursor: pointer; padding: 0.45rem 0.75rem; border-radius: 999px; }
        #pswitch button:hover { background: #333; }
      </style>
      <script>
        const host = document.querySelector<HTMLElement>("[data-variants]");
        const bar = document.getElementById("pswitch")!;
        if (host) {
          const variants = host.dataset.variants!.split(",").map((v) => v.split(":") as [string, string]);
          const label = bar.querySelector("span")!;
          const set = (key: string) => {
            document.documentElement.dataset.variant = key;
            const url = new URL(location.href);
            url.searchParams.set("variant", key);
            history.replaceState(null, "", url);
            const name = variants.find((v) => v[0] === key)?.[1];
            label.textContent = name ? `${key} (${name})` : `${key} (round one)`;
            document.querySelectorAll("a[href^='/']").forEach((a) => {
              const u = new URL((a as HTMLAnchorElement).href);
              u.searchParams.set("variant", key);
              (a as HTMLAnchorElement).href = u.pathname + u.search + u.hash;
            });
          };
          const step = (d: number) => {
            const at = variants.findIndex((v) => v[0] === document.documentElement.dataset.variant);
            set(variants[(at + d + variants.length) % variants.length]![0]);
          };
          bar.hidden = false;
          bar.querySelectorAll("button").forEach((b) => b.addEventListener("click", () => step(Number(b.dataset.d))));
          addEventListener("keydown", (e) => {
            if (e.target instanceof HTMLElement && e.target.closest("input, textarea, [contenteditable]")) return;
            if (e.key === "ArrowLeft") step(-1);
            if (e.key === "ArrowRight") step(1);
          });
          set(document.documentElement.dataset.variant || "A");
        }
      </script>
    </>
  )
}
