---
// A list of items, under a heading per year by default. Each row carries what <Peek> shows for it.
import { excerpt, formatDate, readingTime, hasPage, type Item } from "../lib/content";

type Props = { items: Item[]; byYear?: boolean; cards?: boolean; dates?: boolean };
const { items, byYear = true, cards = false, dates = true } = Astro.props;

const years = byYear
  ? Object.entries(Object.groupBy(items, (i) => i.date.slice(0, 4))).sort(([a], [b]) => b.localeCompare(a))
  : [["", items] as const];
const kindLabel = (i: Item) => (i.external ? "↗" : i.kind === "micro" ? "note" : "");
const meta = (i: Item) =>
  [formatDate(i.date), hasPage(i) && `${readingTime(i)} min`, i.categories.join(", ")].filter(Boolean).join(" · ");
---

{
  years.map(([year, list]) => {
    const ul = (
      <ul class:list={["entries", { cards }]}>
        {list!.map((i) => {
          const x = i.description ?? (hasPage(i) ? excerpt(i) : "");
          return (
            <li class="entry">
              <a href={i.href} data-title={i.title} data-x={x} data-meta={meta(i)}>
                <span class="t">
                  {i.title}
                  {kindLabel(i) && <span class="k">{kindLabel(i)}</span>}
                </span>
                {cards ? x && <span class="x">{x}</span> : dates && <span class="d">{formatDate(i.date, "short")}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    );
    return year ? (
      <section class="year">
        <h2>{year}</h2>
        {ul}
      </section>
    ) : (
      ul
    );
  })

}
