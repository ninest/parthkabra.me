---
// The sidebar's preview: shows the opening of whichever entry the reader points at, so a list of
// titles can be skimmed by what the pages actually say. Starts on the first entry.
type Props = { label?: string };
const { label = "Preview" } = Astro.props;
---

<section class="peek" aria-hidden="true">
  <h2>{label}</h2>
  <div data-peek></div>
</section>

<script>
  const box = document.querySelector<HTMLElement>("[data-peek]");
  const rows = document.querySelectorAll<HTMLAnchorElement>(".entry a[data-title]");
  let shown: HTMLAnchorElement | undefined;
  function show(a: HTMLAnchorElement) {
    if (!box || a === shown) return;
    shown?.parentElement?.classList.remove("on");
    shown = a;
    a.parentElement?.classList.add("on");
    const p = (cls: string, text = "") => Object.assign(document.createElement("p"), { className: cls, textContent: text });
    const wrap = document.createElement("div");
    wrap.className = "peek-swap";
    wrap.append(p("peek-title", a.dataset.title), p("peek-body", a.dataset.x || "…"), p("peek-meta", a.dataset.meta));
    box.replaceChildren(wrap);
  }
  const first = [...rows].find((a) => a.offsetParent);
  if (matchMedia("(hover: hover)").matches && first) {
    show(first);
    rows.forEach((a) => {
      a.addEventListener("mouseenter", () => show(a));
      a.addEventListener("focus", () => show(a));
    });
  } else box?.closest(".peek")?.remove();
</script>
