---
// The site's name as its logo: Allo, fully rounded and loosely spaced, with the single-story a.
interface Props {
  class?: string;
  id?: string;
}
const { class: className = "text-2xl", id } = Astro.props;
---

<span id={id} class:list={["wordmark text-primary", className]}>Parth Kabra</span>

<style>
  .wordmark {
    font-weight: 750;
    font-variation-settings: "ROND" 100, "opsz" 14;
    font-feature-settings: "ss01";
    letter-spacing: 0.03em;
    word-spacing: 0.08em;
    line-height: 1;
  }
</style>
