---
// The site's name as its logo: Allo at its heaviest and roundest, in the page's accent.
interface Props {
  class?: string;
  id?: string;
}
const { class: className = "text-2xl", id } = Astro.props;
---

<span id={id} class:list={["wordmark text-primary", className]}>Parth Kabra</span>

<style>
  .wordmark {
    font-weight: 900;
    font-variation-settings: "ROND" 100, "opsz" 32;
    letter-spacing: -0.02em;
    line-height: 1;
  }
</style>
