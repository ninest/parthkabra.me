---
import type { Item } from "../lib/content";

type Props = { posts: Item[] };
const { posts } = Astro.props;
---

<ul class="space-y-2">
  {
    posts.map((post) => (
      <li>
        <a href={post.href} target={post.external ? "_blank" : undefined} rel={post.external ? "noopener" : undefined}>
          <span class="tabular-nums mr-2">{post.date.slice(0, 7).replace("-", "/")}</span>
          <span class="underline text-primary">{post.title}</span>
        </a>
      </li>
    ))
  }
</ul>
