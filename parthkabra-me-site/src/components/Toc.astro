---
// Contents for the sidebar: follows the reader down the page, and counts down the minutes left.
import type { Heading } from "../lib/markdown";

type Props = { headings: Heading[]; minutes: number };
const { headings, minutes } = Astro.props;
---

<section class="toc" data-minutes={minutes}>
  <h2><span class="left">{minutes} min</span><span class="lbl"> read</span></h2>
  <div class="bar"><i></i></div>
  {
    headings.length > 1 && (
      <ul style="margin-top: 1rem">
        {headings.map((h) => (
          <li class={`d${h.depth}`}>
            <a href={`#${h.id}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    )
  }
</section>

<script>
  const toc = document.querySelector<HTMLElement>(".toc");
  const prose = document.querySelector<HTMLElement>(".prose");
  if (toc && prose) {
    const total = Number(toc.dataset.minutes);
    const left = toc.querySelector(".left")!;
    const label = toc.querySelector(".lbl")!;
    const bar = toc.querySelector<HTMLElement>(".bar > i")!;
    const links = [...toc.querySelectorAll<HTMLAnchorElement>("a")];
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))!);
    let frame = 0;
    const update = () => {
      frame = 0;
      const r = prose.getBoundingClientRect();
      const done = Math.min(1, Math.max(0, (innerHeight * 0.6 - r.top) / r.height));
      bar.style.width = `${done * 100}%`;
      const rest = Math.ceil(total * (1 - done));
      left.textContent = done >= 0.98 ? "Done" : done > 0.02 ? `${rest} min` : `${total} min`;
      label.textContent = done >= 0.98 ? "" : done > 0.02 ? " left" : " read";
      let on = -1;
      targets.forEach((t, n) => t && t.getBoundingClientRect().top < innerHeight * 0.3 && (on = n));
      links.forEach((a, n) => a.classList.toggle("on", n === on));
    };
    addEventListener("scroll", () => (frame ||= requestAnimationFrame(update)), { passive: true });
    update();
  }
</script>
