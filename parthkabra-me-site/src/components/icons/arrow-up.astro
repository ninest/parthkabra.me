---
interface Props {
  class?: string;
  id?: string;
}
const { class: className = "w-4 h-4", id } = Astro.props;
---

<svg
  id={id}
  aria-hidden="true"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  <path d="M12 19V5"></path>
  <path d="m5 12 7-7 7 7"></path>
</svg>
