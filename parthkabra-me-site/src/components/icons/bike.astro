---
interface Props {
  class?: string;
  id?: string;
}
const { class: className = "w-4 h-4", id } = Astro.props;
---

<svg
  id={id}
  aria-hidden="true"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  <circle cx="5.5" cy="17.5" r="3.5"></circle>
  <circle cx="18.5" cy="17.5" r="3.5"></circle>
  <path d="M5.5 17.5 9 9h7l2.5 8.5M9 9l3 8.5L16 9"></path>
  <path d="M7 9h3"></path>
  <path d="M16 9V7M14 7h4"></path>
</svg>
