---
interface Props {
  class?: string;
  id?: string;
}
const { class: className = "w-4 h-4", id } = Astro.props;
---

<svg
  id={id}
  aria-hidden="true"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  <circle cx="11" cy="11" r="7"></circle>
  <path d="m20 20-3.5-3.5"></path>
</svg>
