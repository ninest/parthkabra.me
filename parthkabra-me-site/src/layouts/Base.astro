---
// Every page: the head and the page's colour, if its theme sets one.
import "../styles/global.css";
import ThemeInit from "../components/theme-init.astro";
import { routes } from "../utils/links";

export type Head = { title?: string; fullTitle?: string; description?: string; themeColor?: string };
type Props = { head?: Head };

const siteName = "Parth Kabra";
const { title, fullTitle, description, themeColor } = Astro.props.head ?? {};

const pageTitle = fullTitle ?? (title ? `${title} - ${siteName}` : siteName);
const pageDescription = description ?? "Parth Kabra's personal website";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme-color={themeColor} style={themeColor ? `--page-color: ${themeColor}` : undefined}>
  <head>
    <meta name="theme-color" content={themeColor ?? "#ffffff"} />
    <ThemeInit />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={new URL(routes.rss, Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <slot name="head" />
  </head>

  <body class="bg-background text-foreground" style={themeColor ? `background-color: ${themeColor}` : undefined}>
    {
      themeColor ? (
        <div class="min-h-dvh bg-background">
          <slot />
        </div>
      ) : (
        <slot />
      )
    }
  </body>
</html>
