{
  "name": "parthkabra-me-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "cf:dev": "astro build && wrangler dev --ip 0.0.0.0 --port 2104",
    "cf:preview": "astro build && wrangler versions upload",
    "cf:deploy": "astro build && wrangler deploy",
    "migrate": "wrangler d1 migrations apply me-production --local",
    "migrate:prod": "wrangler d1 migrations apply me-production --remote"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/mulish": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.3.8",
    "compromise": "^14.19.0",
    "lz-string": "^1.5.0",
    "maplibre-gl": "^5.24.0",
    "marked": "^18.1.3",
    "marked-smartypants": "^1.1.12",
    "minisearch": "^7.2.0",
    "pele": "^1.13.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "wrangler": "^4.156.2"
  }
}
