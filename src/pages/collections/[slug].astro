---
export const prerender = true;

import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import CollectionList from "../../components/collection-list.astro";
import SidebarLayout from "../../components/sidebar-layout.astro";
import { resolveRelated } from "../../utils/related";

export const getStaticPaths = (async () => {
  const postCollections = await getCollection("postCollections");
  return postCollections.map((collection) => ({
    params: { slug: collection.id },
    props: { collection },
  }));
}) satisfies GetStaticPaths;

const { collection } = Astro.props;
const items = await resolveRelated(collection.data.items);
---

<SidebarLayout
  head={{ title: collection.data.title, description: collection.data.description }}
  breadcrumbs={[
    { label: "Parth Kabra", href: "/" },
    { label: "Collections", href: "/collections" },
    { label: collection.data.title },
  ]}
>
  <h1 class="text-3xl font-black">{collection.data.title}</h1>

  {collection.data.description && <p class="mt-2 text-muted-foreground">{collection.data.description}</p>}

  <section class="mt-8">
    <ul class="space-y-2">
      {
        items.map((item) => (
          <li>
            <a
              href={item.url ?? "#"}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener" : undefined}
            >
              {item.collection === "posts" && item.createdAt ? (
                <>
                  <span class="tabular-nums">{item.createdAt.getFullYear()}/{String(item.createdAt.getMonth() + 1).padStart(2, "0")}</span>
                  {" "}
                  <span class="underline text-primary">{item.title}</span>
                </>
              ) : (
                <>
                  <span class="text-xs bg-muted rounded px-2 py-1">{item.type}</span>
                  {" "}
                  <span class="underline text-primary">{item.title}</span>
                </>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <CollectionList slot="sidebar" />
</SidebarLayout>
