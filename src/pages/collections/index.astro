---
import { getCollection } from "astro:content";
import CollectionList from "../../components/collection-list.astro";
import SidebarLayout from "../../components/sidebar-layout.astro";
import { getCollectionUrl } from "../../utils/links";

const postCollections = await getCollection("postCollections");
---

<SidebarLayout
  head={{ title: "Collections", description: "Curated collections of posts and projects" }}
  breadcrumbs={[
    { label: "Parth Kabra", href: "/" },
    { label: "Collections" },
  ]}
>
  <h1 class="text-3xl font-black">Collections ({postCollections.length})</h1>

  <section class="mt-8">
    <ul class="space-y-2">
      {
        postCollections.map((collection) => (
          <li>
            <a href={getCollectionUrl(collection.id)}>
              <span class="underline text-primary">{collection.data.title}</span>
            </a>
            {collection.data.description && (
              <span class="text-muted-foreground"> {collection.data.description}</span>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <CollectionList slot="sidebar" />
</SidebarLayout>
