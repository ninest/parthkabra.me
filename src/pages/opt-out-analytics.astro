---
export const prerender = true;

import "../styles/global.css";
import { Font } from "astro:assets";
import ThemeInit from "../components/theme-init.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-mulish" />
    <title>Opt out of analytics - Parth Kabra</title>
    <ThemeInit />
  </head>
  <body class="bg-background text-foreground">
    <main class="p-6 max-w-xl mx-auto">
      <h1 class="font-bold text-lg">Opt out of analytics</h1>
      <p class="mt-2">
        Block PostHog analytics on this browser. The setting lives in <code>localStorage</code>,
        so it's per-device/browser and survives across visits. Visit this page on each device you
        want to opt out.
      </p>

      <div class="mt-5 border border-border p-3">
        <p>
          Status: <span id="status" class="font-mono">…</span>
        </p>
        <button
          id="toggle"
          type="button"
          class="mt-3 px-3 py-1 border border-border cursor-pointer hover:bg-muted"
          disabled
        >
          …
        </button>
      </div>

      <p class="mt-4 text-sm text-muted-foreground">
        Clearing site data for this origin will reset this setting.
      </p>
    </main>

    <script is:inline>
      const KEY = "analytics_opted_out";
      const $status = document.getElementById("status");
      const $toggle = document.getElementById("toggle");

      function isOptedOut() {
        return localStorage.getItem(KEY) === "1";
      }

      function render() {
        const optedOut = isOptedOut();
        $status.textContent = optedOut ? "Blocked" : "Allowed";
        $toggle.textContent = optedOut ? "Unblock analytics" : "Block analytics";
        $toggle.disabled = false;
      }

      $toggle.addEventListener("click", () => {
        if (isOptedOut()) {
          localStorage.removeItem(KEY);
        } else {
          localStorage.setItem(KEY, "1");
        }
        render();
      });

      render();
    </script>
  </body>
</html>
