---
export const prerender = true;

import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import DefaultToolLayout from "../../components/tools/DefaultToolLayout.astro";

export const getStaticPaths = (async () => {
  const tools = await getCollection("tools");
  return tools.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;

const skinModules = import.meta.glob<{ default: any }>(
  "../../components/tools/skins/*.astro",
  { eager: true },
);

function resolveToolSkin(name: string | undefined) {
  if (!name) return null;
  const key = `../../components/tools/skins/${name}.astro`;
  const mod = skinModules[key];
  if (!mod) {
    throw new Error(
      `[skins] tool entry "${entry.id}" references theme "${name}" but ${key} does not exist. ` +
        `Available: ${Object.keys(skinModules).join(", ") || "(none)"}`,
    );
  }
  return mod.default;
}

const Skin = resolveToolSkin(entry.data.theme);
---

{Skin ? <Skin entry={entry} /> : <DefaultToolLayout entry={entry} />}
