---
export const prerender = true;

import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import MicroblogPost from "../../../components/microblog/microblog-post.astro";
import SidebarLayout from "../../../components/sidebar-layout.astro";
import { getMicroblogUrl } from "../../../utils/links";
import { stripMarkdown } from "../../../utils/markdown";
import {
  getMicroblogAncestorRoots,
  getMicroblogDescendantChain,
} from "../../../utils/microblog-thread";
import { firstSentence, truncate } from "../../../utils/string";

export const getStaticPaths = (async () => {
  const entries = await getCollection("microblog");

  return entries.map((entry) => {
    const [year, slug] = entry.id.split("/");
    return {
      params: { year, slug },
      props: { entry },
    };
  });
}) satisfies GetStaticPaths;

const { entry } = Astro.props;

const [chain, roots] = await Promise.all([
  getMicroblogDescendantChain(entry.id),
  getMicroblogAncestorRoots(entry.id),
]);

const rootLinks = roots.map((r) => ({
  id: r.id,
  url: `${getMicroblogUrl(r.id)}?from=${encodeURIComponent(entry.id)}`,
  label: r.data.title ?? truncate(firstSentence(stripMarkdown(r.body ?? "")), 40),
}));

const plain = stripMarkdown(entry.body ?? "");
const seoTitle = entry.data.title ?? truncate(firstSentence(plain), 60);
const seoDescription = entry.data.description ?? truncate(plain, 155);
---

<SidebarLayout
  head={{ title: seoTitle, description: seoDescription }}
  breadcrumbs={[{ label: "Parth Kabra", href: "/" }, { label: "Microblog" }]}
>
  {
    rootLinks.length > 0 && (
      <nav class="mb-3">
        {rootLinks.length === 1 ? (
          <a href={rootLinks[0].url} class="underline text-primary">
            View full thread from &ldquo;{rootLinks[0].label}&rdquo;
          </a>
        ) : (
          <span>
            View full thread from:{" "}
            {rootLinks.map((r, i) => (
              <>
                {i > 0 && <span class="mx-1">&middot;</span>}
                <a href={r.url} class="underline text-primary">
                  {r.label}
                </a>
              </>
            ))}
          </span>
        )}
      </nav>
    )
  }

  <div class="flex flex-col gap-4">
    {chain.map((post) => <MicroblogPost mb={post} />)}
  </div>
</SidebarLayout>

<script>
  // When the URL carries ?from=<microblog-id>, outline that post so readers
  // see where they came from after clicking "View full thread".
  const params = new URLSearchParams(window.location.search);
  const from = params.get("from");
  if (from) {
    const $article = document.getElementById(`microblog-${from}`);
    if ($article) {
      $article.dataset.highlighted = "";
    }
  }
</script>
