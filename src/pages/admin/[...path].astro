---
import AdminLayout from "../../layouts/AdminLayout.astro";
import Button from "../../components/button.astro";
import Input from "../../components/input.astro";
import { listDirectory, getFile, getFileSafe, listDirectorySafe } from "../../lib/github";
import { getImagePath } from "../../config/admin";
import { getTemplatePath } from "../../config/templates";
import type { DirEntry } from "../../lib/github";
import { getMicroblogThreadMembers, getMicroblogThreadRootSizes } from "../../utils/microblog-thread";
import { env } from "cloudflare:workers";

const { path } = Astro.params;
if (!path) return Astro.redirect("/admin");

const token = env.GITHUB_TOKEN;
if (!token) return new Response("GITHUB_TOKEN not configured", { status: 500 });

const isNew = Astro.url.searchParams.has("new");

// Build breadcrumbs
const segments = path.split("/");
const filteredSegments = segments.filter((seg) => seg !== "content");
const breadcrumbs = [
  { label: "Admin", href: "/admin" },
  ...filteredSegments.map((seg, i) => ({
    label: seg,
    href: i < filteredSegments.length - 1
      ? `/admin/content/${filteredSegments.slice(0, i + 1).join("/")}`
      : undefined,
  })),
];

// Determine what we're looking at
let isDirectory = false;
let dirItems: DirEntry[] = [];
let fileContent = "";
let fileSha = "";
let images: DirEntry[] = [];
let imagePath: string | null = null;
let error = "";

type ThreadMember = { id: string; title: string; adminUrl: string; isCurrent: boolean };
let threadMembers: ThreadMember[] = [];
let threadRootSizes: Map<string, number> = new Map();

try {
  if (isNew) {
    // New file mode — load template if one exists for this collection
    isDirectory = false;
    imagePath = null;
    const templatePath = getTemplatePath(path);
    if (templatePath) {
      const template = await getFileSafe(token, templatePath);
      if (template) {
        fileContent = template.content;
        // If ?thread=... is set, prefill the commented `thread:` line in the template.
        const threadRef = Astro.url.searchParams.get("thread");
        if (threadRef) {
          fileContent = fileContent.replace(/^#\s*thread:.*$/m, `thread: ${threadRef}`);
        }
      }
    }
  } else {
    // Try as directory first, fall back to file
    try {
      dirItems = await listDirectory(token, path);
      isDirectory = true;

      // Sort MDX/MD files by createdAt (newest first), directories stay on top
      const dirs = dirItems.filter((i) => i.type === "dir");
      const mdxFiles = dirItems.filter((i) => i.type === "file" && /\.mdx?$/.test(i.name));
      const otherFiles = dirItems.filter((i) => i.type === "file" && !/\.mdx?$/.test(i.name));

      if (mdxFiles.length > 0) {
        const withDates = await Promise.all(
          mdxFiles.map(async (item) => {
            const file = await getFileSafe(token, item.path);
            let createdAt = "";
            if (file) {
              const match = file.content.match(/createdAt:\s*(.+)/);
              if (match) createdAt = match[1].trim();
            }
            return { item, createdAt };
          }),
        );
        withDates.sort((a, b) => b.createdAt.localeCompare(a.createdAt));
        dirItems = [...dirs, ...withDates.map((f) => f.item), ...otherFiles];
      }

      // For microblog directories, mark which files are thread roots so the
      // list can render a label. Reflects last-built collection data.
      if (path.startsWith("content/microblog/")) {
        threadRootSizes = await getMicroblogThreadRootSizes();
      }
    } catch {
      isDirectory = false;
      const file = await getFile(token, path);
      fileContent = file.content;
      fileSha = file.sha;

      // Load images for this file
      imagePath = getImagePath(path);
      if (imagePath) {
        images = await listDirectorySafe(token, imagePath);
      }

      // Resolve thread members for microblog files (content reflects last build, so
      // newly-created replies won't appear until the site is rebuilt).
      const microblogMatch = path.match(/^content\/microblog\/(.+)\.mdx$/);
      if (microblogMatch) {
        const entryId = microblogMatch[1];
        const members = await getMicroblogThreadMembers(entryId);
        if (members.length > 1) {
          threadMembers = members.map((m) => ({
            id: m.id,
            title: m.data.title || m.id,
            adminUrl: `/admin/content/microblog/${m.id}.mdx`,
            isCurrent: m.id === entryId,
          }));
        }
      }
    }
  }
} catch (e: any) {
  error = e.message;
}

// URL for "Add post to thread" button: opens the new-file flow in the current
// folder with `?thread=microblog:<rootId>` to prefill the thread field.
let addToThreadUrl: string | null = null;
if (threadMembers.length > 1) {
  const rootId = threadMembers[0].id;
  const parentDir = path.replace(/\/[^/]+$/, "");
  addToThreadUrl = `/admin/${parentDir}?new=true&thread=${encodeURIComponent(`microblog:${rootId}`)}`;
}

// For the image panel, derive the web-accessible path (strip "public/")
function toWebPath(ghPath: string): string {
  return "/" + ghPath.replace(/^public\//, "");
}

// Extract the microblog entry id from a file path (e.g. "content/microblog/2026/foo.mdx" → "2026/foo").
function microblogIdFromPath(ghPath: string): string | null {
  const m = ghPath.match(/^content\/microblog\/(.+)\.mdx$/);
  return m ? m[1] : null;
}
---

<AdminLayout title={segments[segments.length - 1]} breadcrumbs={breadcrumbs}>
  {error ? (
    <p class="text-red-600 font-mono text-sm">{error}</p>
  ) : isDirectory ? (
    <!-- Directory listing -->
    <a href={`/admin/${path}?new=true`} class="px-3 py-1 bg-muted rounded text-sm inline-block mb-4">+ New file</a>
    <ul class="space-y-1 font-mono text-sm">
      {dirItems.map((item) => {
        const mbId = item.type === "file" ? microblogIdFromPath(item.path) : null;
        const threadSize = mbId ? threadRootSizes.get(mbId) : undefined;
        return (
          <li>
            <a href={`/admin/${item.path}`} class="underline">
              {item.type === "dir" ? `${item.name}/` : item.name}
            </a>
            {threadSize && (
              <span class="ml-2 text-xs text-muted-foreground">thread · {threadSize} posts</span>
            )}
          </li>
        );
      })}
    </ul>
  ) : (
    <!-- Editor -->
    <div id="editor-root" data-path={path} data-sha={fileSha} data-image-path={imagePath ?? ""} class="flex flex-col gap-4 lg:flex-row lg:h-[calc(100vh-8rem)]">
      {/* Main editor area */}
      <div class="flex-1 min-w-0 flex flex-col min-h-0">
        {isNew && (
          <input
            id="new-filename"
            type="text"
            placeholder="filename.mdx"
            class="border border-border rounded px-2 py-1 font-mono text-sm w-64 mb-3 block shrink-0"
          />
        )}

        <textarea
          id="editor"
          class="w-full flex-1 min-h-[75vh] lg:min-h-0 font-mono text-sm p-3 border border-border rounded bg-background text-foreground resize-none"
          style="tab-size: 2; -moz-tab-size: 2;"
        >{fileContent}</textarea>
      </div>

      {/* Sidebar */}
      <div class="w-full lg:w-72 shrink-0 flex flex-col gap-4 min-h-0 overflow-y-auto">
        {/* Save */}
        <div>
          <Button id="save-btn" class="w-full text-sm">
            Save
          </Button>
          <span id="save-status" class="text-sm mt-1 block"></span>
        </div>

        {/* Thread */}
        {threadMembers.length > 1 && (
          <div class="border-t border-border pt-4">
            <p class="text-sm font-semibold mb-2">Thread</p>
            <ol class="space-y-1">
              {threadMembers.map((m, i) => (
                <li class="text-sm flex gap-2">
                  <span class="text-muted-foreground tabular-nums shrink-0">{i + 1}.</span>
                  {m.isCurrent ? (
                    <span class="font-semibold truncate">{m.title}</span>
                  ) : (
                    <a href={m.adminUrl} class="underline truncate">{m.title}</a>
                  )}
                </li>
              ))}
            </ol>
            {addToThreadUrl && (
              <a href={addToThreadUrl} class="mt-3 px-3 py-1 bg-muted rounded text-sm inline-block">
                + Add post to thread
              </a>
            )}
          </div>
        )}

        {/* Related content search */}
        <div class="border-t border-border pt-4">
          <p class="text-sm font-semibold mb-2">Related content</p>
          <Input
            id="ref-search"
            type="text"
            placeholder="Search content..."
            autocomplete="off"
            class="rounded px-2 py-1 text-sm w-full"
          />
          <ul id="ref-results" class="mt-2 space-y-0.5 rounded overflow-hidden max-h-64 overflow-y-auto"></ul>
        </div>

        {/* Images */}
        {imagePath && (
          <div class="border-t border-border pt-4">
            <p class="text-sm font-semibold mb-2">Images</p>
            {images.length > 0 ? (
              <div class="grid grid-cols-2 gap-2 mb-3">
                {images.map((img) => (
                  <div class="border border-border rounded p-1">
                    <img src={toWebPath(img.path)} class="w-full" loading="lazy" />
                    <button
                      class="copy-img-ref text-xs font-mono mt-1 truncate block w-full text-left underline cursor-pointer"
                      data-ref={`![](${toWebPath(img.path)})`}
                    >
                      {img.name}
                    </button>
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-sm text-muted-foreground mb-3">No images yet.</p>
            )}
            <div class="flex items-center gap-2">
              <input type="file" id="image-upload" accept="image/*" class="text-sm w-full" />
              <Button id="upload-btn" class="text-sm whitespace-nowrap">
                Upload
              </Button>
            </div>
            <span id="upload-status" class="text-sm mt-1 block"></span>
          </div>
        )}
      </div>
    </div>
  )}
</AdminLayout>

<script>
  import { actions } from "astro:actions";
  import { compressImageToWebp, formatBytes } from "../../lib/image";

  const $root = document.getElementById("editor-root");
  if ($root) {
    const $editor = document.getElementById("editor") as HTMLTextAreaElement;
    const $saveBtn = document.getElementById("save-btn")!;
    const $saveStatus = document.getElementById("save-status")!;
    const $newFilename = document.getElementById("new-filename") as HTMLInputElement | null;

    let currentPath = $root.dataset.path!;
    let currentSha = $root.dataset.sha || "";

    // Expand template placeholders. {{datetime}} is local time with seconds
    // (e.g. 2026-04-20T11:23:45) so same-day posts preserve their ordering.
    if ($editor.value.includes("{{date}}") || $editor.value.includes("{{datetime}}")) {
      const now = new Date();
      const pad = (n: number) => String(n).padStart(2, "0");
      const date = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
      const datetime = `${date}T${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
      $editor.value = $editor.value.replaceAll("{{datetime}}", datetime).replaceAll("{{date}}", date);
    }

    $saveBtn.addEventListener("click", save);

    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === "s") {
        e.preventDefault();
        save();
      }
    });

    // Tab inserts 4 spaces instead of changing focus
    $editor.addEventListener("keydown", (e) => {
      if (e.key === "Tab") {
        e.preventDefault();
        const start = $editor.selectionStart;
        const end = $editor.selectionEnd;
        $editor.value = $editor.value.substring(0, start) + "  " + $editor.value.substring(end);
        $editor.selectionStart = $editor.selectionEnd = start + 2;
      }
    });

    async function save() {
      // For new files, build path from directory + filename
      let savePath = currentPath;
      if ($newFilename) {
        const filename = $newFilename.value.trim();
        if (!filename) {
          $saveStatus.textContent = "Enter a filename";
          $saveStatus.className = "text-sm text-red-600";
          return;
        }
        savePath = `${currentPath}/${filename}`;
      }

      $saveBtn.textContent = "Saving...";
      $saveStatus.textContent = "";

      const { data, error } = await actions.saveFile({
        path: savePath,
        content: $editor.value,
        ...(currentSha ? { sha: currentSha } : {}),
      });

      if (error) {
        $saveStatus.textContent = error.message;
        $saveStatus.className = "text-sm text-red-600";
      } else {
        currentSha = data.sha;
        $saveStatus.textContent = "Saved";
        $saveStatus.className = "text-sm text-green-600";

        // If it was a new file, redirect to the edit page
        if ($newFilename) {
          window.location.href = `/admin/${savePath}`;
        }
      }

      $saveBtn.textContent = "Save";
    }

    // Copy image markdown reference
    document.querySelectorAll(".copy-img-ref").forEach((btn) => {
      btn.addEventListener("click", () => {
        const ref = (btn as HTMLElement).dataset.ref!;
        navigator.clipboard.writeText(ref);
        const original = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => (btn.textContent = original), 1000);
      });
    });

    // Image upload
    const $uploadBtn = document.getElementById("upload-btn");
    const $imageUpload = document.getElementById("image-upload") as HTMLInputElement | null;
    const $uploadStatus = document.getElementById("upload-status");

    if ($uploadBtn && $imageUpload && $uploadStatus) {
      $uploadBtn.addEventListener("click", async () => {
        const original = $imageUpload.files?.[0];
        if (!original) return;

        $uploadBtn.textContent = "Compressing...";
        $uploadStatus.className = "text-sm mt-1 block";
        $uploadStatus.textContent = `Compressing ${formatBytes(original.size)}...`;

        let toUpload: File;
        try {
          toUpload = await compressImageToWebp(original);
        } catch {
          toUpload = original;
        }

        // Astro's default actionBodySizeLimit is 1 MB; base64 inflates by ~4/3.
        const ACTION_LIMIT = 1024 * 1024;
        const estimatedBody = Math.ceil((toUpload.size * 4) / 3);

        if (estimatedBody > ACTION_LIMIT) {
          const passthrough = toUpload === original;
          $uploadStatus.textContent = passthrough
            ? `File too large (${formatBytes(toUpload.size)}). SVG/GIF/AVIF are uploaded as-is; please shrink manually.`
            : `Compressed file still exceeds 1 MB (${formatBytes(toUpload.size)}). Try a smaller source image.`;
          $uploadStatus.className = "text-sm text-red-600 mt-1 block";
          $uploadBtn.textContent = "Upload";
          return;
        }

        if (toUpload !== original) {
          const pct = Math.round((1 - toUpload.size / original.size) * 100);
          $uploadStatus.textContent = `Compressed ${formatBytes(original.size)} → ${formatBytes(toUpload.size)} (${pct}% smaller). Uploading...`;
        } else {
          $uploadStatus.textContent = `Uploading ${formatBytes(toUpload.size)}...`;
        }
        $uploadBtn.textContent = "Uploading...";

        const formData = new FormData();
        formData.append("file", toUpload);
        formData.append("path", $root.dataset.imagePath!);

        const { data, error } = await actions.uploadImage(formData);

        if (error) {
          $uploadStatus.textContent = error.message;
          $uploadStatus.className = "text-sm text-red-600 mt-1 block";
        } else {
          $uploadStatus.textContent = `Uploaded ${data.path}. Refresh to see.`;
          $uploadStatus.className = "text-sm text-green-600 mt-1 block";
        }

        $uploadBtn.textContent = "Upload";
      });
    }

    // Related content search
    const $refSearch = document.getElementById("ref-search") as HTMLInputElement | null;
    const $refResults = document.getElementById("ref-results");

    if ($refSearch && $refResults) {
      type ContentRef = { ref: string; title: string; type: string };
      let allRefs: ContentRef[] | null = null;
      let refDebounce: ReturnType<typeof setTimeout>;

      async function loadRefs(): Promise<ContentRef[]> {
        if (allRefs) return allRefs;
        const res = await fetch("/admin/content-refs.json");
        allRefs = await res.json();
        return allRefs!;
      }

      function renderRefResults(results: ContentRef[]) {
        if (results.length === 0) {
          $refResults!.innerHTML = `<li class="text-muted-foreground text-sm py-1 px-2">No results</li>`;
          return;
        }
        const displayed = results.slice(0, 15);
        $refResults!.innerHTML = displayed
          .map(
            (r) =>
              `<li>
                <button class="copy-ref flex items-center justify-between bg-muted/50 py-1 px-2 w-full text-left cursor-pointer" data-ref="${r.ref}">
                  <span class="text-sm truncate">${r.title}</span>
                  <span class="text-xs text-muted-foreground shrink-0 ml-2">${r.type}</span>
                </button>
              </li>`,
          )
          .join("");

        $refResults!.querySelectorAll<HTMLButtonElement>(".copy-ref").forEach(($btn) => {
          $btn.addEventListener("click", () => {
            const ref = $btn.dataset.ref!;
            navigator.clipboard.writeText(ref);
            const originalHTML = $btn.innerHTML;
            $btn.innerHTML = `<span class="text-sm text-green-600">Copied: ${ref}</span>`;
            setTimeout(() => ($btn.innerHTML = originalHTML), 1000);
          });
        });
      }

      $refSearch.addEventListener("input", () => {
        clearTimeout(refDebounce);
        const query = $refSearch.value.trim().toLowerCase();
        if (!query) {
          $refResults!.innerHTML = "";
          return;
        }
        refDebounce = setTimeout(async () => {
          const refs = await loadRefs();
          const filtered = refs.filter(
            (r) =>
              r.title.toLowerCase().includes(query) ||
              r.ref.toLowerCase().includes(query),
          );
          renderRefResults(filtered);
        }, 150);
      });
    }
  }
</script>
