---
import type { HTMLAttributes } from "astro/types";
import { buttonBaseClasses, buttonVariantClasses, type ButtonVariant } from "./button";

interface Props extends HTMLAttributes<"button"> {
  variant?: ButtonVariant;
}

const { variant = "secondary", class: className, ...rest } = Astro.props;
---

<button class:list={[buttonBaseClasses, buttonVariantClasses[variant], className]} {...rest}>
  <slot />
</button>
