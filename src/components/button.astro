---
import type { HTMLAttributes } from "astro/types";
import {
  buttonBaseClasses,
  buttonSizeClasses,
  buttonVariantClasses,
  type ButtonSize,
  type ButtonVariant,
} from "./button";

interface Props extends HTMLAttributes<"button"> {
  variant?: ButtonVariant;
  size?: ButtonSize;
}

const { variant = "secondary", size = "md", class: className, ...rest } = Astro.props;
---

<button
  class:list={[buttonBaseClasses, buttonSizeClasses[size], buttonVariantClasses[variant], className]}
  {...rest}
>
  <slot />
</button>
