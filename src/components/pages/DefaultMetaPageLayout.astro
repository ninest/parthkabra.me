---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import SidebarLayout from "../sidebar-layout.astro";
import ArticleLinks from "../article-links.astro";
import DefaultMetaPageSidebar from "./DefaultMetaPageSidebar.astro";
import { resolveRelated } from "../../utils/related";

interface Props {
  entry: CollectionEntry<"pages">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const relatedItems = await resolveRelated(entry.data.related);
---

<SidebarLayout
  head={{ title: entry.data.title, description: entry.data.description }}
  breadcrumbs={[
    { label: "Parth Kabra", href: "/" },
  ]}
>
  <h1 class="text-3xl font-black">{entry.data.title}</h1>

  {entry.data.description && (
    <p class="mt-2 text-muted-foreground">{entry.data.description}</p>
  )}

  <ArticleLinks
    title="Links"
    external
    items={entry.data.links}
  />

  <ArticleLinks title="Related" items={relatedItems} />

  <article class="mt-8 typography">
    <Content />
  </article>

  <DefaultMetaPageSidebar entry={entry} slot="sidebar" />
</SidebarLayout>
