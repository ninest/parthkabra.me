---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import SidebarLayout from "../sidebar-layout.astro";
import DefaultProjectSidebar from "./DefaultProjectSidebar.astro";
import { routes } from "../../utils/links";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const dateline = entry.data.createdAt.toLocaleDateString("en-US", { month: "long", year: "numeric" });
---

<SidebarLayout
  head={{ title: entry.data.title, description: entry.data.description }}
  breadcrumbs={[
    { label: "Parth Kabra", href: "/" },
    { label: "Projects", href: routes.projects },
  ]}
>
  <h1 class="text-3xl font-black">{entry.data.title}</h1>

  <p class="mt-2 text-muted-foreground">{dateline} · {entry.data.description}</p>

  <article class="mt-8 typography">
    <Content />
  </article>

  <DefaultProjectSidebar entry={entry} slot="sidebar" />
</SidebarLayout>

<script is:inline define:vars={{ projectTitle: entry.data.title, projectId: entry.id }}>
  function trackProjectViewed() {
    window.posthog?.capture('project_viewed', { project_title: projectTitle, project_id: projectId });
  }
  document.addEventListener('DOMContentLoaded', trackProjectViewed);
  document.addEventListener('astro:page-load', trackProjectViewed);
</script>
