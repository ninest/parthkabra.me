---
interface Item {
  title: string;
  url?: string | null;
  external?: boolean;
}

interface Props {
  title: string;
  items: Item[];
  external?: boolean;
  linkClass?: string;
}

const { title, items, external = false, linkClass = "text-primary underline" } = Astro.props;
---

<script>
  // Use event delegation so external link clicks are tracked across view transitions
  document.addEventListener('click', (e) => {
    const $a = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-ph-external]');
    if ($a) {
      window.posthog?.capture('external_link_clicked', { url: $a.dataset.phExternal, link_title: $a.dataset.phLinkTitle });
    }
  });
</script>

{
  items.length > 0 && (
    <section class="mt-7">
      <p class="font-bold">{title}</p>
      <div class="ml-5 flex flex-wrap gap-x-3 gap-y-1">
        {items.map((item) => {
          const isExternal = external || item.external;
          return item.url ? (
            <a
              href={item.url}
              class={linkClass}
              target={isExternal ? "_blank" : undefined}
              rel={isExternal ? "noopener" : undefined}
              data-ph-external={isExternal ? item.url : undefined}
              data-ph-link-title={isExternal ? item.title : undefined}
            >
              {item.title}
            </a>
          ) : (
            <span>{item.title}</span>
          );
        })}
      </div>
    </section>
  )
}
