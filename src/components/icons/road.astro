---
interface Props {
  class?: string;
  id?: string;
}
const { class: className = "w-4 h-4", id } = Astro.props;
---

<svg
  id={id}
  aria-hidden="true"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  <path d="M7.5 21 10 3"></path>
  <path d="M16.5 21 14 3"></path>
</svg>
