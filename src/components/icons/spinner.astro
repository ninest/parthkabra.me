---
interface Props {
  class?: string;
  id?: string;
}
const { class: className = "w-4 h-4", id } = Astro.props;
---

<svg
  id={id}
  aria-hidden="true"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  class:list={["animate-spin", className]}
>
  <circle cx="12" cy="12" r="9" opacity="0.25"></circle>
  <path d="M21 12a9 9 0 0 0-9-9"></path>
</svg>
