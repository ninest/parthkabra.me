---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { routes } from "../../utils/links";
import MicroblogPost from "./microblog-post.astro";

interface Props {
  microblogs?: CollectionEntry<"microblog">[];
  title?: string;
  showViewAll?: boolean;
}

const { microblogs: providedMicroblogs, title = "Microblog", showViewAll = true } = Astro.props;

const microblogs = providedMicroblogs ?? (await getCollection("microblog"))
  .sort((a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime())
  .slice(0, 10);
---

<section>
  <div class="flex items-center justify-between">
    <h2 class="font-bold">{title}</h2>
    {showViewAll && <a href={routes.microblog} class="underline text-sm text-primary">View all</a>}
  </div>
  <ul class="ml-5 mt-1 mb-10 space-y-2">
    {
      microblogs.map((mb) => (
        <li>
          <MicroblogPost mb={mb} size="sm" truncate />
        </li>
      ))
    }
  </ul>
</section>
