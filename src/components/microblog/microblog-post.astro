---
import { render, type CollectionEntry } from "astro:content";
import { resolveRelated } from "../../utils/related";
import { getMicroblogUrl } from "../../utils/links";
import ArticleLinks from "../article-links.astro";

interface Props {
  mb: CollectionEntry<"microblog">;
  /**
   * When true, the card renders with an outline. Typically set at runtime via
   * the `data-highlighted` attribute (e.g. from a `?from=...` query param) so
   * readers can see which post they arrived from in a thread.
   */
  highlighted?: boolean;
  /** When true, show a "Thread: ..." link to the thread root. */
  showThread?: boolean;
  /**
   * Visual density. `md` is the full card; `sm` is a compact card for sidebars
   * (tighter padding, smaller text, dateline inline with title at top, no chrome).
   */
  size?: "sm" | "md";
  /** When true, clamp the body and append a "Read more" link to the full post. */
  truncate?: boolean;
}

const {
  mb,
  highlighted = false,
  showThread = false,
  size = "md",
  truncate = false,
} = Astro.props;
const { Content } = await render(mb);

const isSm = size === "sm";
const url = getMicroblogUrl(mb.id);

const dateline = mb.data.createdAt.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

const replyTarget = !isSm && mb.data.inReplyTo
  ? (await resolveRelated([mb.data.inReplyTo]))[0]
  : undefined;

const threadRoot = !isSm && showThread && mb.data.thread
  ? (await resolveRelated([mb.data.thread]))[0]
  : undefined;

const relatedItems = !isSm ? await resolveRelated(mb.data.related) : [];
---

<article
  id={`microblog-${mb.id}`}
  class:list={[
    "microblog-card relative bg-muted rounded-lg data-highlighted:ring-2 data-highlighted:ring-primary/40",
    isSm ? "px-2 pt-2 pb-4 rounded" : "p-3",
  ]}
  data-highlighted={highlighted ? "" : undefined}
>
  {threadRoot && (
    <p class="text-muted-foreground text-sm mb-1">
      Thread: <a href={threadRoot.url} class="underline">{threadRoot.title}</a>
    </p>
  )}

  {replyTarget && (
    <p class="text-muted-foreground text-sm mb-1">
      In reply to <a href={replyTarget.url} class="underline">{replyTarget.title}</a>
    </p>
  )}

  {isSm ? (
    mb.data.title && (
      <a
        href={url}
        class="microblog-card-link block text-muted-foreground text-xs leading-snug"
      >
        {mb.data.title}
      </a>
    )
  ) : (
    mb.data.title && (
      <a href={url} class="text-muted-foreground hover:underline">
        {mb.data.title}
      </a>
    )
  )}

  <div
    class:list={[
      "typography",
      isSm ? "mt-1 text-sm [&_li]:leading-[1.45] [&_p]:leading-[1.45] [&_p:not(:first-child)]:mt-2" : "mt-4 mb-4",
      "[&_img]:max-h-[60vh] [&_img]:w-auto [&_img]:max-w-full",
      truncate && "line-clamp-4 [&_p]:inline [&_p+p]:before:content-['_']",
    ]}
  >
    <Content />
  </div>

  {truncate && (
    <a href={url} class="relative z-10 mt-1 inline-block text-xs underline">
      Read more
    </a>
  )}

  {!isSm && (
    <>
      <ArticleLinks title="Links" external items={mb.data.links} />
      <ArticleLinks title="Related" items={relatedItems} />

      <div class="mt-4 text-muted-foreground text-sm">
        {dateline}
      </div>
    </>
  )}
</article>

<style>
  /* Make the whole compact card clickable via the title anchor. Tailwind has no
     pseudo-element generator for positional inset, so this stays as scoped CSS. */
  .microblog-card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
</style>
