---
import { render, type CollectionEntry } from "astro:content";
import { getMicroblogUrl } from "../../utils/links";

interface Props {
  mb: CollectionEntry<"microblog">;
}

const { mb } = Astro.props;
const { Content } = await render(mb);

const formatDate = (d: Date) => `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, "0")}`;
---

<article id={`microblog-${mb.id}`} class="microblog-card relative px-2 pt-2 pb-4 bg-muted rounded">
  <a href={getMicroblogUrl(mb.id)} class="microblog-card-link tabular-nums text-muted-foreground text-xs">
    {formatDate(mb.data.createdAt)}
    {mb.data.title}
  </a>
  <div class="microblog-preview typography mt-1 text-sm line-clamp-4">
    <Content />
  </div>
</article>

<style>
  .microblog-card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .microblog-preview :global(p) {
    display: inline;
    line-height: 1.4 !important;
  }
  .microblog-preview :global(p + p)::before {
    content: " ";
  }
</style>
