---
import { getCollection } from "astro:content";
import { routes, getCollectionUrl } from "../utils/links";

const postCollections = await getCollection("postCollections");
---

<nav class="mt-8">
  <div class="text-sm font-bold">Collections</div>
  <ul class="mt-2 flex flex-wrap gap-1 rounded-md overflow-hidden">
    <li class="grow min-w-[20%]">
      <a href={routes.collections} class="block bg-muted py-1 px-2 text-center">All</a>
    </li>
    {
      postCollections.map((collection) => (
        <li class="grow min-w-[20%]">
          <a href={getCollectionUrl(collection.id)} class="block bg-muted py-1 px-2 text-center">
            {collection.data.title}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
