---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import SidebarLayout from "../sidebar-layout.astro";
import DefaultPostSidebar from "./DefaultPostSidebar.astro";
import ContentRenderer from "../content/ContentRenderer.astro";
import { getCategoryUrl } from "../../utils/links";

interface Props {
  entry: CollectionEntry<"posts">;
}

const { entry } = Astro.props;
const [categoryId] = entry.id.split("/");

const categories = await getCollection("categories");
const categoryTitle = categories.find((c) => c.id === categoryId)?.data.title ?? categoryId;

const dateline = entry.data.createdAt.toLocaleDateString("en-US", { month: "long", year: "numeric" });
---

<SidebarLayout
  head={{ title: entry.data.title, description: entry.data.description }}
  breadcrumbs={[
    { label: "Parth Kabra", href: "/" },
    { label: categoryTitle, href: getCategoryUrl(categoryId) },
  ]}
>
  <h1 class="text-3xl font-black">{entry.data.title}</h1>

  <p class="mt-2 text-muted-foreground">{dateline} · {entry.data.description}</p>

  <article class="mt-8 typography">
    <ContentRenderer entry={entry} />
  </article>

  <DefaultPostSidebar entry={entry} slot="sidebar" />
</SidebarLayout>

<script is:inline define:vars={{ postTitle: entry.data.title, postCategory: categoryId, postCategoryTitle: categoryTitle }}>
  function trackPostViewed() {
    window.posthog?.capture('post_viewed', { post_title: postTitle, category: postCategory, category_title: postCategoryTitle });
  }
  document.addEventListener('DOMContentLoaded', trackPostViewed);
  document.addEventListener('astro:page-load', trackPostViewed);
</script>
