---
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Navbar from "../../navbar.astro";
import Search from "../../search.astro";
import SidebarColumns from "../../sidebar-columns.astro";
import DefaultWorkSidebar from "../DefaultWorkSidebar.astro";
import { routes } from "../../../utils/links";
import type { WorkSkinProps } from "./types";

interface Props extends WorkSkinProps {}

const wayfairPurple = "#712199";

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base
  head={{
    title: entry.data.title,
    description: entry.data.description,
    themeColor: wayfairPurple,
  }}
>
  <div style={`--primary: ${wayfairPurple}`}>
    <div class="bg-primary">
      <div class="px-4">
        <div class="max-w-300 mx-auto py-1 text-white">
          <Navbar
            breadcrumbs={[
              { label: "Parth Kabra", href: "/" },
              { label: "Work", href: routes.work },
            ]}
          />
        </div>
      </div>
    </div>

    <div class="px-4">
      <div class="max-w-300 mx-auto mb-16">
        <div class="mt-8">
          <SidebarColumns>
            <div class="flex items-end gap-1">
              <img src="/icons/work/wayfair.svg" alt="Wayfair logo" class="size-10" />
              <h1
                class="text-5xl font-black tracking-tight lowercase text-primary"
                style="font-family: var(--font-mulish), sans-serif"
              >
                {entry.data.title}
              </h1>
            </div>

            <p class="mt-2 text-muted-foreground">
              {entry.data.description} · {entry.data.location} · {entry.data.dateline}
            </p>

            <article class="mt-8 typography">
              <Content />
            </article>

            <Fragment slot="sidebar">
              <Search
                class:list={[
                  "gap-0!",
                  "[&_input]:border-black dark:[&_input]:border-gray-500 [&_input]:border-r-0",
                  "[&_button]:bg-primary [&_button]:text-white",
                ]}
              />

              <DefaultWorkSidebar entry={entry} />
            </Fragment>
          </SidebarColumns>
        </div>
      </div>
    </div>
  </div>
</Base>
