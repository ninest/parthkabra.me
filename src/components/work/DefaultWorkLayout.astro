---
import type { CollectionEntry } from "astro:content";
import SidebarLayout from "../sidebar-layout.astro";
import DefaultWorkSidebar from "./DefaultWorkSidebar.astro";
import ContentRenderer from "../content/ContentRenderer.astro";
import { routes } from "../../utils/links";

interface Props {
  entry: CollectionEntry<"workExperience">;
}

const { entry } = Astro.props;
---

<SidebarLayout
  head={{ title: entry.data.title, description: entry.data.description }}
  breadcrumbs={[
    { label: "Parth Kabra", href: "/" },
    { label: "Work", href: routes.work },
  ]}
>
  <div class="flex items-center gap-3">
    {entry.data.icon && <img src={entry.data.icon} alt={`${entry.data.title} logo`} class="w-6 h-6" />}
    <h1 class="text-3xl font-black">{entry.data.title}</h1>
  </div>

  <p class="mt-2 text-muted-foreground">{entry.data.description} · {entry.data.location} · {entry.data.dateline}</p>

  <article class="mt-8 typography">
    <ContentRenderer entry={entry} />
  </article>

  <DefaultWorkSidebar entry={entry} slot="sidebar" />
</SidebarLayout>

<script is:inline define:vars={{ workTitle: entry.data.title, workId: entry.id }}>
  function trackWorkViewed() {
    window.posthog?.capture('work_viewed', { work_title: workTitle, work_id: workId });
  }
  document.addEventListener('DOMContentLoaded', trackWorkViewed);
  document.addEventListener('astro:page-load', trackWorkViewed);
</script>
