---
import type { CollectionEntry } from "astro:content";
import { getPostLink } from "../utils/links";

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
---

<ul class="space-y-2">
  {
    posts.map((post) => {
      const link = getPostLink(post.id, post.data.externalUrl);
      return (
        <li>
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener" : undefined}
          >
            <span class="tabular-nums mr-2">
              {post.data.createdAt.getFullYear()}/{String(post.data.createdAt.getMonth() + 1).padStart(2, "0")}
            </span>
            <span class="underline text-primary">{post.data.title}</span>
          </a>
        </li>
      );
    })
  }
</ul>
