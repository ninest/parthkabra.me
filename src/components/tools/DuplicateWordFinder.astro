<div class="not-typography relative flex h-full w-full flex-col overflow-hidden md:flex-row">
  <div class="min-w-0 flex-1 resize overflow-auto bg-gray-50 dark:bg-neutral-900">
    <textarea
      id="duplicate-word-input"
      class="block h-full w-full resize-none p-5"
      placeholder="Paste your essay here ..."
    ></textarea>
  </div>
  <aside class="h-2/5 w-full shrink-0 overflow-auto p-5 md:h-auto md:w-96 md:min-w-36">
    <div id="duplicate-word-results"></div>
  </aside>
</div>

<script>
  import { findDuplicateWords } from "../../lib/duplicate-word";

  const $input = document.getElementById("duplicate-word-input") as HTMLTextAreaElement | null;
  const $results = document.getElementById("duplicate-word-results");

  function renderDuplicateWords() {
    if (!$input || !$results) return;

    const duplicates = findDuplicateWords($input.value, { ignoreStopWords: true });
    $results.replaceChildren(
      ...duplicates.map((duplicate) => {
        const $line = document.createElement("div");
        $line.textContent = duplicate.word;
        return $line;
      }),
    );
  }

  $input?.addEventListener("input", renderDuplicateWords);
  renderDuplicateWords();
</script>
