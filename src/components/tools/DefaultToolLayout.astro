---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Navbar from "../navbar.astro";
import Search from "../search.astro";
import ArticleLinks from "../article-links.astro";
import { resolveRelated } from "../../utils/related";
import { routes } from "../../utils/links";

interface Props {
  entry: CollectionEntry<"tools">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const relatedItems = await resolveRelated(entry.data.related);
const dateline = entry.data.createdAt.toLocaleDateString("en-US", { month: "long", year: "numeric" });
---

<Base head={{ title: entry.data.title, description: entry.data.description }}>
  <div class="px-4">
    <div class="max-w-300 mx-auto my-16">
      <Navbar
        breadcrumbs={[
          { label: "Parth Kabra", href: "/" },
          { label: "Tools", href: routes.tools },
        ]}
      />

      <div class="mt-8 flex flex-col md:flex-row gap-12 lg:gap-24">
        <div class="flex-1 min-w-0">
          <h1 class="text-3xl font-black">{entry.data.title}</h1>
          <p class="mt-2 text-muted-foreground">{dateline} · {entry.data.description}</p>
        </div>
        <div class="hidden md:block md:w-72 lg:w-84 shrink-0">
          <Search />
        </div>
      </div>

      <ArticleLinks title="Links" external items={entry.data.links} />
      <ArticleLinks title="Related" items={relatedItems} />

      <article class="mt-8 typography">
        <Content />
      </article>
    </div>
  </div>
</Base>
