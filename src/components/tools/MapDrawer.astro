---
import Button from "../button.astro";
---

<div id="mapdrawer" class="not-typography relative w-full h-full">
  <div id="mapdrawer-map" class="w-full h-full"></div>

  <div
    id="md-controls"
    class="absolute bottom-4 left-4 flex flex-wrap items-center gap-2 bg-background/90 border border-border rounded-lg shadow px-3 py-2 backdrop-blur max-w-[calc(100%-2rem)]"
  >
    <Button id="md-mode-point" variant="secondary" class="text-sm">Point</Button>
    <Button id="md-mode-line" variant="secondary" class="text-sm">Line</Button>
    <Button id="md-finish-line" variant="secondary" class="text-sm hidden">Finish line</Button>
    <span class="mx-1 h-5 w-px bg-border"></span>
    <div id="md-swatches" class="flex flex-wrap items-center gap-1"></div>
    <span class="mx-1 h-5 w-px bg-border"></span>
    <Button id="md-my-location" variant="secondary" class="text-sm">My location</Button>
    <span id="md-status" class="text-xs text-muted-foreground"></span>
    <span class="mx-1 h-5 w-px bg-border"></span>
    <button
      id="md-collapse-toggle"
      type="button"
      aria-label="Hide controls"
      aria-expanded="true"
      class="text-sm w-7 h-7 rounded hover:bg-muted flex items-center justify-center shrink-0 ml-auto"
    >
      <span id="md-collapse-icon" aria-hidden="true">▾</span>
    </button>
  </div>

  <style is:global>
    /* When collapsed, hide every direct child of the control bar except the caret itself.
       New buttons added inside the bar are automatically covered — no per-item wiring.
       Padding collapses to a single unit so the bar becomes a square pill around the caret. */
    #md-controls[data-collapsed="true"] > *:not(#md-collapse-toggle) {
      display: none;
    }
    #md-controls[data-collapsed="true"] {
      padding: 0.25rem;
    }
    /* Same glyph in both states; rotate 180deg when collapsed so it matches the expanded caret exactly. */
    #md-controls[data-collapsed="true"] #md-collapse-icon {
      transform: rotate(180deg);
    }
  </style>

  <div
    class="absolute top-4 left-4 right-4 sm:left-auto sm:w-80 max-w-[calc(100vw-2rem)] flex flex-col gap-2"
  >
  <div
    id="md-list-panel"
    class="hidden bg-background/90 border border-border rounded-lg shadow backdrop-blur overflow-hidden"
  >
    <div class="flex items-stretch">
      <button
        id="md-list-toggle"
        type="button"
        class="flex-1 px-3 py-2 flex items-center justify-between gap-2 text-sm bg-muted/60 hover:bg-muted"
      >
        <span>Items</span>
        <span id="md-list-count" class="text-muted-foreground text-xs">0</span>
      </button>
      <button
        id="md-list-overflow"
        type="button"
        aria-label="More actions"
        aria-expanded="false"
        class="px-3 bg-muted/60 hover:bg-muted text-muted-foreground shrink-0 border-l border-border flex items-center"
      >
        <span aria-hidden="true">⋯</span>
      </button>
    </div>
    <div
      id="md-list-extras"
      class="hidden flex-col gap-2 p-2 border-t border-border"
    >
      <Button id="md-copy-link" variant="secondary" class="text-sm">Copy link</Button>
      <Button id="md-toggle-labels" variant="secondary" class="text-sm">Hide map labels</Button>
      <Button id="md-clear" variant="outline" class="text-sm text-error">Clear all</Button>
    </div>
    <div
      id="md-list-body"
      class="hidden flex-col gap-2 p-2 max-h-[min(20rem,calc(100vh-13rem))] overflow-y-auto border-t border-border"
    >
    </div>
  </div>

  <input
    id="md-search-input"
    type="text"
    placeholder="Search a place"
    autocomplete="off"
    spellcheck="false"
    class="w-full px-3 py-1.5 text-base leading-tight bg-background/90 border border-border rounded-lg shadow backdrop-blur focus:outline-none"
  />
  <p
    id="md-search-status"
    class="hidden text-xs text-muted-foreground self-start bg-background/90 border border-border rounded px-2 py-0.5 backdrop-blur shadow"
  >
  </p>
  </div>
</div>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  import { buttonClasses } from "../button";
  import { inputClasses } from "../input";
  import { reverseGeocode, geocode } from "../../utils/geolocation";
  import {
    PALETTE,
    SRC_DRAWINGS,
    SRC_PREVIEW,
    getFeatureCoord,
    createDrawingSourcesAndLayers,
    type DrawingFeature,
    type FeatureCollection,
    type FeatureProps,
    type LngLat,
  } from "../../utils/map-drawing";
  import {
    readUrlState,
    writeDrawingsParam,
    writeLabelsParam,
  } from "../../utils/map-drawing-url";

  // === DOM refs ===
  const $mapEl = document.getElementById("mapdrawer-map")!;
  const $modePoint = document.getElementById("md-mode-point") as HTMLButtonElement;
  const $modeLine = document.getElementById("md-mode-line") as HTMLButtonElement;
  const $finishLine = document.getElementById("md-finish-line") as HTMLButtonElement;
  const $myLocation = document.getElementById("md-my-location") as HTMLButtonElement;
  const $clear = document.getElementById("md-clear") as HTMLButtonElement;
  const $copyLink = document.getElementById("md-copy-link") as HTMLButtonElement;
  const $toggleLabels = document.getElementById("md-toggle-labels") as HTMLButtonElement;
  const $status = document.getElementById("md-status")!;
  const $swatches = document.getElementById("md-swatches")!;
  const $listPanel = document.getElementById("md-list-panel")!;
  const $listToggle = document.getElementById("md-list-toggle") as HTMLButtonElement;
  const $listCount = document.getElementById("md-list-count")!;
  const $listBody = document.getElementById("md-list-body")!;
  const $listOverflow = document.getElementById("md-list-overflow") as HTMLButtonElement;
  const $listExtras = document.getElementById("md-list-extras")!;
  const $searchInput = document.getElementById("md-search-input") as HTMLInputElement;
  const $searchStatus = document.getElementById("md-search-status")!;
  const $controls = document.getElementById("md-controls")!;
  const $collapseToggle = document.getElementById("md-collapse-toggle") as HTMLButtonElement;

  // === State ===
  // mode is null until the user explicitly picks Point or Line — map clicks are ignored otherwise.
  let mode: "point" | "line" | null = null;
  let features: DrawingFeature[] = [];
  let linePoints: LngLat[] = [];
  let myLocationMarker: maplibregl.Marker | null = null;
  let searchMarker: maplibregl.Marker | null = null;
  let activeColorIdx = 0;
  // Counters are monotonic so two features never share an auto-name, even after edits.
  let pointCounter = 0;
  let lineCounter = 0;
  let listExpanded = false;

  // === Collapse toggle ===
  // Sets data-collapsed on the bar; CSS above hides every child except the caret itself
  // and rotates the caret icon 180deg. Persisted in localStorage so "view-only" survives reloads.
  const COLLAPSE_STORAGE_KEY = "md-controls-collapsed";
  function applyControlsCollapsed(collapsed: boolean) {
    if (collapsed) $controls.setAttribute("data-collapsed", "true");
    else $controls.removeAttribute("data-collapsed");
    $collapseToggle.setAttribute("aria-expanded", String(!collapsed));
    $collapseToggle.setAttribute("aria-label", collapsed ? "Show controls" : "Hide controls");
  }
  applyControlsCollapsed(localStorage.getItem(COLLAPSE_STORAGE_KEY) === "1");
  $collapseToggle.addEventListener("click", () => {
    const next = $controls.getAttribute("data-collapsed") !== "true";
    applyControlsCollapsed(next);
    localStorage.setItem(COLLAPSE_STORAGE_KEY, next ? "1" : "0");
  });

  // === Swatch rendering ===

  // Build a round colored swatch button of the given hex color.
  function makeSwatchButton(hex: string, label: string, active: boolean): HTMLButtonElement {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.setAttribute("aria-label", label);
    btn.className =
      "w-8 h-8 rounded flex items-center justify-center shrink-0 " +
      (active ? "ring-2 ring-primary" : "hover:bg-muted");
    const dot = document.createElement("span");
    dot.className = "block w-[18px] h-[18px] rounded-full border border-border";
    dot.style.backgroundColor = hex;
    btn.appendChild(dot);
    return btn;
  }

  // Render the palette row in the toolbar. Tap to set the active color for new features.
  function renderSwatches() {
    $swatches.innerHTML = "";
    PALETTE.forEach(([label, hex], i) => {
      const btn = makeSwatchButton(hex, `Use ${label}`, i === activeColorIdx);
      btn.addEventListener("click", () => setActiveColor(i));
      $swatches.appendChild(btn);
    });
  }

  // Set the active color: updates the palette UI and the preview layers on the map.
  function setActiveColor(idx: number) {
    activeColorIdx = idx;
    renderSwatches();
    const hex = PALETTE[idx][1];
    if (map.loaded()) {
      if (map.getLayer("preview-point")) map.setPaintProperty("preview-point", "circle-color", hex);
      if (map.getLayer("preview-line")) map.setPaintProperty("preview-line", "line-color", hex);
    }
  }

  // === Row extras & address cache ===

  // Close any open per-row disclosure and disarm any "Sure?" delete buttons inside.
  function closeAllRowExtras() {
    $listBody.querySelectorAll("[data-row-extra]").forEach((el) => {
      el.classList.add("hidden");
      el.classList.remove("flex");
    });
    $listBody.querySelectorAll("[data-delete-armed]").forEach((el) => {
      (el as HTMLButtonElement).textContent = "Delete";
      el.removeAttribute("data-delete-armed");
    });
  }

  // Reverse-geocoded addresses are cached per feature (not serialized in the URL) and only
  // resolved when the user opens a feature's extras panel, to keep Nominatim traffic minimal.
  const addressCache = new WeakMap<DrawingFeature, string | null>();
  const addressPending = new WeakMap<DrawingFeature, Promise<string | null>>();

  // Kick off reverse geocoding for a feature if we haven't already. Re-runs onUpdate
  // after the result lands so the DOM bound to the extras panel can refresh.
  function ensureAddress(f: DrawingFeature, onUpdate: () => void) {
    if (addressCache.has(f) || addressPending.has(f)) {
      onUpdate();
      return;
    }
    const { lat, lng } = getFeatureCoord(f);
    const p = reverseGeocode(lat, lng).then((result) => {
      addressCache.set(f, result ?? null);
      addressPending.delete(f);
      onUpdate();
      return result ?? null;
    });
    addressPending.set(f, p);
    onUpdate();
  }

  // === Feature list rendering ===

  // Render the right-side list of features. One row per feature: color chip, name input, kind label.
  // e.g. "● [Home________] point" with a color popover below that opens on chip tap.
  function renderList() {
    $listPanel.classList.toggle("hidden", features.length === 0);
    $listCount.textContent = String(features.length);
    $listBody.innerHTML = "";
    features.forEach((f, i) => {
      const wrap = document.createElement("div");
      wrap.className = "flex flex-col gap-1";

      const row = document.createElement("div");
      row.className = "flex items-center gap-2";

      const chip = makeSwatchButton(PALETTE[f.properties.colorIdx][1], "Change color", false);

      const input = document.createElement("input");
      input.type = "text";
      input.value = f.properties.name;
      input.className = inputClasses("flex-1 min-w-0 rounded px-2 py-1 bg-transparent");
      input.setAttribute("autocomplete", "off");
      input.setAttribute("autocorrect", "off");
      input.setAttribute("autocapitalize", "words");
      input.setAttribute("spellcheck", "false");
      const commit = () => {
        const v = input.value.trim();
        if (v && v !== features[i].properties.name) {
          features[i].properties.name = v;
          writeUrl();
        } else {
          input.value = features[i].properties.name;
        }
      };
      input.addEventListener("blur", commit);
      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          commit();
          input.blur();
        }
      });

      // Overflow menu — same target as the color chip: toggles the shared extras panel below.
      const overflow = document.createElement("button");
      overflow.type = "button";
      overflow.setAttribute("aria-label", "More actions");
      overflow.className =
        "w-8 h-8 rounded flex items-center justify-center shrink-0 text-muted-foreground hover:bg-muted";
      overflow.textContent = "\u22EF"; // ⋯

      // Shared row-extras panel: palette picker on top, delete underneath.
      const extras = document.createElement("div");
      extras.setAttribute("data-row-extra", "");
      extras.className = "hidden flex-col gap-2 pl-10";

      const swatchRow = document.createElement("div");
      swatchRow.className = "flex flex-wrap gap-1";
      PALETTE.forEach(([label, hex], j) => {
        const opt = makeSwatchButton(hex, label, j === f.properties.colorIdx);
        opt.addEventListener("click", (e) => {
          e.stopPropagation();
          features[i].properties.colorIdx = j;
          closeAllRowExtras();
          rerender();
        });
        swatchRow.appendChild(opt);
      });

      // Address block — reverse-geocoded lazily when extras open, with a copy-to-clipboard link.
      const addrBlock = document.createElement("div");
      addrBlock.className = "flex flex-col gap-0.5";
      const addrText = document.createElement("p");
      addrText.className = "text-xs text-muted-foreground break-words";
      const copyAddrBtn = document.createElement("button");
      copyAddrBtn.type = "button";
      copyAddrBtn.className = "text-xs underline cursor-pointer self-start hidden";
      copyAddrBtn.textContent = "Copy address";
      addrBlock.appendChild(addrText);
      addrBlock.appendChild(copyAddrBtn);
      const applyAddressState = () => {
        const cached = addressCache.get(f);
        if (cached === undefined) {
          addrText.textContent = addressPending.has(f) ? "Resolving..." : "";
          copyAddrBtn.classList.add("hidden");
        } else if (cached) {
          addrText.textContent = cached;
          copyAddrBtn.classList.remove("hidden");
        } else {
          addrText.textContent = "Address unknown";
          copyAddrBtn.classList.add("hidden");
        }
      };
      applyAddressState();
      copyAddrBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const text = addrText.textContent;
        if (!text) return;
        navigator.clipboard.writeText(text);
        copyAddrBtn.textContent = "Copied!";
        setTimeout(() => (copyAddrBtn.textContent = "Copy address"), 1500);
      });

      // Label visibility toggle — per-feature show/hide of the on-map name label.
      const labelBtn = document.createElement("button");
      labelBtn.type = "button";
      labelBtn.className = buttonClasses("outline", "self-start text-sm");
      labelBtn.textContent = f.properties.hideLabel ? "Show label" : "Hide label";
      labelBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        features[i].properties.hideLabel = !features[i].properties.hideLabel;
        closeAllRowExtras();
        rerender();
      });

      // Delete uses a two-step "Delete" → "Sure?" arm, mirroring the Clear all button.
      // The arm auto-expires after 3s, and closeAllRowExtras() also disarms it.
      const deleteBtn = document.createElement("button");
      deleteBtn.type = "button";
      deleteBtn.className = buttonClasses("outline", "self-start text-sm text-error");
      deleteBtn.textContent = "Delete";
      deleteBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        if (!deleteBtn.hasAttribute("data-delete-armed")) {
          deleteBtn.setAttribute("data-delete-armed", "");
          deleteBtn.textContent = "Sure?";
          setTimeout(() => {
            if (deleteBtn.hasAttribute("data-delete-armed")) {
              deleteBtn.removeAttribute("data-delete-armed");
              deleteBtn.textContent = "Delete";
            }
          }, 3000);
          return;
        }
        features.splice(i, 1);
        closeAllRowExtras();
        rerender();
      });

      extras.appendChild(swatchRow);
      extras.appendChild(labelBtn);
      extras.appendChild(addrBlock);
      extras.appendChild(deleteBtn);

      // Both chip and overflow open/close the same panel.
      const toggleExtras = (e: Event) => {
        e.stopPropagation();
        const willOpen = extras.classList.contains("hidden");
        closeAllRowExtras();
        if (willOpen) {
          extras.classList.remove("hidden");
          extras.classList.add("flex");
          ensureAddress(f, applyAddressState);
        }
      };
      chip.addEventListener("click", toggleExtras);
      overflow.addEventListener("click", toggleExtras);

      row.appendChild(chip);
      row.appendChild(input);
      row.appendChild(overflow);
      wrap.appendChild(row);
      wrap.appendChild(extras);
      $listBody.appendChild(wrap);
    });
  }

  // Toggle the list body visible/hidden. Starts collapsed on every load to keep the map unobstructed.
  function setListExpanded(open: boolean) {
    listExpanded = open;
    $listBody.classList.toggle("hidden", !open);
    $listBody.classList.toggle("flex", open);
    if (!open) closeAllRowExtras();
  }
  $listToggle.addEventListener("click", () => setListExpanded(!listExpanded));

  // Toggles the list-level overflow panel (Copy link / Clear all).
  // Closing always disarms the Clear button so reopening never shows a stale "Sure?" state.
  function setListExtrasOpen(open: boolean) {
    $listExtras.classList.toggle("hidden", !open);
    $listExtras.classList.toggle("flex", open);
    $listOverflow.setAttribute("aria-expanded", String(open));
    if (!open) disarmClear();
  }
  $listOverflow.addEventListener("click", (e) => {
    e.stopPropagation();
    setListExtrasOpen($listExtras.classList.contains("hidden"));
  });

  // Close per-row popovers and the list-level overflow on any click outside them.
  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    if (!$listBody.contains(target)) closeAllRowExtras();
    if (!$listExtras.contains(target) && !$listOverflow.contains(target)) {
      setListExtrasOpen(false);
    }
  });

  // === URL state (wraps utils/map-drawing-url) ===

  // Parse every drawer-owned param up front (features, counters, labels flag) so map
  // init can fit bounds and labels apply on the first frame — one read, one source of truth.
  const initialUrlState = readUrlState(new URLSearchParams(window.location.search));
  features = initialUrlState.features;
  pointCounter = initialUrlState.pointCounter;
  lineCounter = initialUrlState.lineCounter;

  // Push `features` into the URL's drawings params.
  function writeUrl() {
    const url = new URL(window.location.href);
    writeDrawingsParam(url, features);
    history.replaceState(null, "", url.toString());
  }
  let initialBounds: maplibregl.LngLatBounds | null = null;
  if (features.length > 0) {
    initialBounds = new maplibregl.LngLatBounds();
    for (const f of features) {
      if (f.geometry.type === "Point") {
        initialBounds.extend(f.geometry.coordinates);
      } else {
        for (const c of f.geometry.coordinates) initialBounds.extend(c);
      }
    }
  }

  // === Map init ===
  // Default to Boston when no drawing is loaded from the URL — users can hit "My location" to jump elsewhere.
  const BOSTON: LngLat = [-71.0589, 42.3601];
  const map = new maplibregl.Map({
    container: $mapEl,
    style: "https://tiles.openfreemap.org/styles/positron",
    center: initialBounds ? initialBounds.getCenter().toArray() : BOSTON,
    zoom: 12,
    dragRotate: true,
    pitchWithRotate: true,
    // Disable the default non-compact attribution so we can add a compact one below.
    attributionControl: false,
  });
  map.addControl(new maplibregl.AttributionControl({ compact: true }));
  if (initialBounds) {
    map.fitBounds(initialBounds, { padding: 60, maxZoom: 14 });
  }

  // Fullscreen layouts can init the map before the container is fully laid out,
  // which leaves the canvas blank. A ResizeObserver guarantees resize when size settles.
  new ResizeObserver(() => map.resize()).observe($mapEl);

  map.on("error", (e) => {
    console.error("[MapDrawer] map error:", e.error ?? e);
  });

  // === Dark mode ===
  // Invert canvas when site is in dark mode.
  function applyDarkMode() {
    const isDark = document.documentElement.classList.contains("dark");
    const canvas = $mapEl.querySelector("canvas");
    if (canvas) {
      canvas.style.filter = isDark ? "invert(1) hue-rotate(180deg)" : "";
    }
  }
  new MutationObserver(applyDarkMode).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["class"],
  });

  // === Collection builders & rerender ===

  // Build the FeatureCollection currently rendered as the committed drawings.
  function collection(): FeatureCollection {
    return { type: "FeatureCollection", features };
  }

  // Preview collection for the in-progress line while the user is clicking points in line mode.
  // Preview paint uses the active color via setPaintProperty, so these properties aren't rendered —
  // we just fill them to satisfy FeatureProps.
  function previewCollection(): FeatureCollection {
    const props: FeatureProps = { name: "", colorIdx: activeColorIdx };
    if (linePoints.length === 0) {
      return { type: "FeatureCollection", features: [] };
    }
    if (linePoints.length === 1) {
      return {
        type: "FeatureCollection",
        features: [
          {
            type: "Feature",
            geometry: { type: "Point", coordinates: linePoints[0] },
            properties: props,
          },
        ],
      };
    }
    return {
      type: "FeatureCollection",
      features: [
        {
          type: "Feature",
          geometry: { type: "LineString", coordinates: linePoints },
          properties: props,
        },
      ],
    };
  }

  // Push current state into maplibre sources + URL + list.
  function rerender() {
    const drawings = map.getSource(SRC_DRAWINGS) as maplibregl.GeoJSONSource | undefined;
    if (drawings) drawings.setData(collection() as any);
    const preview = map.getSource(SRC_PREVIEW) as maplibregl.GeoJSONSource | undefined;
    if (preview) preview.setData(previewCollection() as any);
    $finishLine.classList.toggle("hidden", !(mode === "line" && linePoints.length >= 2));
    renderList();
    writeUrl();
  }

  // === Map load: add sources + layers ===
  map.on("load", () => {
    applyDarkMode();
    createDrawingSourcesAndLayers(map, {
      initialDrawings: collection(),
      initialPreview: previewCollection(),
      initialPreviewHex: PALETTE[activeColorIdx][1],
    });
    renderSwatches();
    renderList();
    applyLabelsVisible();
  });

  // === Mode (point / line) ===

  // Apply primary (active) vs secondary (inactive) styling to a mode button.
  function styleButton(btn: HTMLButtonElement, active: boolean) {
    btn.classList.toggle("bg-primary", active);
    btn.classList.toggle("text-primary-foreground", active);
    btn.classList.toggle("bg-muted", !active);
  }

  function setMode(next: "point" | "line" | null) {
    if (next === mode) return;
    if (mode === "line" && next !== "line") {
      // Switching away from line mode discards any in-progress line.
      linePoints = [];
    }
    mode = next;
    if (mode === "line") {
      map.doubleClickZoom.disable();
    } else {
      map.doubleClickZoom.enable();
    }
    styleButton($modePoint, mode === "point");
    styleButton($modeLine, mode === "line");
    rerender();
  }

  // Clicking an active mode deselects it — back to no mode.
  $modePoint.addEventListener("click", () => setMode(mode === "point" ? null : "point"));
  $modeLine.addEventListener("click", () => setMode(mode === "line" ? null : "line"));

  // === Finish line / click handlers ===

  // Commit the in-progress line to features.
  function finishLine() {
    if (linePoints.length < 2) return;
    lineCounter++;
    features.push({
      type: "Feature",
      geometry: { type: "LineString", coordinates: linePoints },
      properties: { name: `Line ${lineCounter}`, colorIdx: activeColorIdx },
    });
    linePoints = [];
    rerender();
  }
  $finishLine.addEventListener("click", finishLine);

  // Map click: add point, or append to in-progress line. No-op if no mode is active.
  map.on("click", (e) => {
    if (mode === null) return;
    const coord: LngLat = [e.lngLat.lng, e.lngLat.lat];
    if (mode === "point") {
      pointCounter++;
      features.push({
        type: "Feature",
        geometry: { type: "Point", coordinates: coord },
        properties: { name: `Point ${pointCounter}`, colorIdx: activeColorIdx },
      });
      rerender();
    } else if (mode === "line") {
      linePoints.push(coord);
      rerender();
    }
  });

  // Double-click finishes a line in line mode.
  map.on("dblclick", (e) => {
    if (mode !== "line") return;
    e.preventDefault();
    finishLine();
  });

  // === Clear all (two-step) ===
  // First click arms the button ("Sure?"); a second click within the timeout performs the wipe.
  // Clicking anywhere else, or waiting 3s, disarms it.
  let clearArmed = false;
  let clearResetTimer: ReturnType<typeof setTimeout> | null = null;

  function disarmClear() {
    clearArmed = false;
    $clear.textContent = "Clear all";
    if (clearResetTimer) {
      clearTimeout(clearResetTimer);
      clearResetTimer = null;
    }
  }

  $clear.addEventListener("click", (e) => {
    e.stopPropagation();
    if (!clearArmed) {
      clearArmed = true;
      $clear.textContent = "Sure?";
      clearResetTimer = setTimeout(disarmClear, 3000);
      return;
    }
    disarmClear();
    features = [];
    linePoints = [];
    pointCounter = 0;
    lineCounter = 0;
    if (myLocationMarker) {
      myLocationMarker.remove();
      myLocationMarker = null;
    }
    if (searchMarker) {
      searchMarker.remove();
      searchMarker = null;
    }
    setListExtrasOpen(false);
    rerender();
  });

  // Any click outside the clear button disarms it.
  document.addEventListener("click", (e) => {
    if (clearArmed && e.target !== $clear) disarmClear();
  });

  // === Map labels visibility ===
  // Toggles every symbol layer in the base style except our own drawing labels.
  // Persists as ?hl=1 in the URL (absent = labels shown, the default).
  const CUSTOM_LABEL_LAYER_IDS = new Set(["drawings-point-labels", "drawings-line-labels"]);
  let labelsVisible = initialUrlState.labelsVisible;

  function applyLabelsVisible() {
    // Don't gate on map.isStyleLoaded(): adding our drawing sources inside the load handler
    // flips isStyleLoaded() false while they settle, which used to make the reload path bail
    // out and leave hl=1 unrespected. The base symbol layers already exist in getStyle().layers
    // by the time load fires, and setLayoutProperty queues the change safely either way.
    const layers = map.getStyle()?.layers || [];
    for (const layer of layers) {
      if (layer.type !== "symbol") continue;
      if (CUSTOM_LABEL_LAYER_IDS.has(layer.id)) continue;
      map.setLayoutProperty(layer.id, "visibility", labelsVisible ? "visible" : "none");
    }
  }

  function updateLabelsButton() {
    $toggleLabels.textContent = labelsVisible ? "Hide map labels" : "Show map labels";
  }
  updateLabelsButton();

  $toggleLabels.addEventListener("click", (e) => {
    e.stopPropagation();
    labelsVisible = !labelsVisible;
    updateLabelsButton();
    applyLabelsVisible();
    const url = new URL(window.location.href);
    writeLabelsParam(url, labelsVisible);
    history.replaceState(null, "", url.toString());
  });

  // === Copy link ===
  $copyLink.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      const prev = $copyLink.textContent;
      $copyLink.textContent = "Copied!";
      setTimeout(() => ($copyLink.textContent = prev), 1500);
    } catch {
      $status.textContent = "Copy failed";
      setTimeout(() => ($status.textContent = ""), 1500);
    }
  });

  // === My location ===
  // Non-persistent blue marker + flyTo.
  $myLocation.addEventListener("click", () => {
    if (!navigator.geolocation) {
      $status.textContent = "Geolocation unavailable";
      return;
    }
    $status.textContent = "Locating...";
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const { latitude, longitude } = pos.coords;
        if (myLocationMarker) myLocationMarker.remove();
        const el = document.createElement("div");
        el.style.cssText =
          "width:1.125rem;height:1.125rem;background:#2563eb;border:0.156rem solid white;border-radius:50%;box-shadow:0 0.125rem 0.375rem rgba(0,0,0,.35);";
        myLocationMarker = new maplibregl.Marker({ element: el })
          .setLngLat([longitude, latitude])
          .addTo(map);
        map.flyTo({ center: [longitude, latitude], zoom: 14 });
        $status.textContent = "";
      },
      () => {
        $status.textContent = "Location denied";
        setTimeout(() => ($status.textContent = ""), 2000);
      },
      { enableHighAccuracy: true, timeout: 10000 },
    );
  });

  // === Search (geocode) ===
  // Forward-geocode a query and fly the map to it with an ephemeral dashed pin.
  // The pin is deliberately a dashed ring (not a solid marker) so it reads as "temporary /
  // where you just looked" rather than a committed point. Replaced on each search; cleared by Clear all.
  function setSearchStatus(text: string) {
    $searchStatus.textContent = text;
    $searchStatus.classList.toggle("hidden", !text);
  }

  async function runSearch() {
    const q = $searchInput.value.trim();
    if (!q) return;
    setSearchStatus("Searching...");
    const result = await geocode(q);
    if (!result) {
      setSearchStatus("No results");
      return;
    }
    setSearchStatus("");
    if (searchMarker) searchMarker.remove();
    const el = document.createElement("div");
    el.style.cssText =
      "width:1.75rem;height:1.75rem;border:0.156rem dashed #2563eb;background:rgba(37,99,235,0.15);border-radius:50%;box-sizing:border-box;";
    searchMarker = new maplibregl.Marker({ element: el })
      .setLngLat([result.lng, result.lat])
      .addTo(map);
    map.flyTo({ center: [result.lng, result.lat], zoom: 14 });
  }

  $searchInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      runSearch();
    }
  });
  // Clear a lingering "No results" as soon as the user starts editing again.
  $searchInput.addEventListener("input", () => {
    if ($searchStatus.textContent === "No results") setSearchStatus("");
  });
</script>

<style>
  #mapdrawer-map {
    z-index: 0;
  }
</style>
