---
import Navbar from "./navbar.astro";
import Search from "./search.astro";
import SidebarColumns from "./sidebar-columns.astro";
import Base from "../layouts/Base.astro";

interface Props {
  breadcrumbs?: { label: string; href?: string }[];
  head?: {
    title?: string;
    description?: string;
  };
}

const { breadcrumbs, head } = Astro.props;
---

<Base head={head}>
  <div class="px-4">
    <div class="max-w-300 mx-auto my-16">
      <Navbar breadcrumbs={breadcrumbs} />

      <div class="mt-8">
        <SidebarColumns>
          <slot />
          <Fragment slot="sidebar">
            <Search />
            <slot name="sidebar" />
          </Fragment>
        </SidebarColumns>
      </div>
    </div>
  </div>
</Base>
